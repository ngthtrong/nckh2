{
  "schema_version": "v2.analysis-contract.3",
  "id": "contract.analysis.v2",
  "analysis_unit": "paired_confirmation_seed",
  "observation_snapshot": {
    "base_time": "2026-10-15T00:00:00Z",
    "cutoff_min_after_base_time": 150,
    "report_inclusion_rule": "received_at_at_or_before_cutoff",
    "missing_event_time_action": "retain_as_observed_then_route_to_manual_review",
    "incident_evaluation_rule": "evaluator_incident_start_at_or_before_cutoff",
    "batch_job_ready_rule": "all_predicted_jobs_ready_at_declared_cutoff",
    "late_report_action": "exclude_from_this_snapshot_without_imputation"
  },
  "operational_metric_parameters": {
    "review_cluster_min_reports": 2,
    "review_mean_provenance_threshold": 0.4,
    "unresolved_report_review_units": "one_per_report",
    "false_destination_definition": "emitted_cluster_containing_only_noise_reports"
  },
  "selection_rules": [
    {
      "id": "selection.common.one_se",
      "applies_to_method_ids": [
        "method.additive_louvain",
        "method.hdbscan_geo_time",
        "method.product_louvain",
        "method.st_dbscan"
      ],
      "selection_scope": "within_each_method_independently",
      "selection_split": "calibration",
      "candidate_unit": "configuration_id",
      "one_configuration_per_method": true,
      "required_calibration_seed_count": 20,
      "eligibility": {
        "complete_seed_coverage_required": true,
        "finite_required_endpoints": true,
        "positive_denominators_required": true,
        "failed_candidate_action": "mark_candidate_ineligible"
      },
      "ranking_semantics": "lexicographic_after_one_standard_error_filter",
      "steps": [
        {
          "order": 1,
          "action": "identify_best_mean_ari",
          "endpoint_id": "endpoint.clustering.ari_labeled_reports",
          "statistic": "unweighted_mean_over_20_calibration_seeds",
          "direction": "higher"
        },
        {
          "order": 2,
          "action": "retain_one_standard_error_set",
          "endpoint_id": "endpoint.clustering.ari_labeled_reports",
          "formula": "mean_ari_candidate >= mean_ari_best - standard_error_ari_best",
          "standard_error_definition": "sample_standard_deviation_of_best_candidate_ari_over_sqrt_20",
          "inclusive": true
        },
        {
          "order": 3,
          "action": "rank_within_one_standard_error_set",
          "endpoint_id": "endpoint.operational.false_destinations_per_100_reports",
          "statistic": "unweighted_mean_over_20_calibration_seeds",
          "direction": "lower"
        },
        {
          "order": 4,
          "action": "rank_remaining_ties",
          "endpoint_id": "endpoint.secondary.noise_rejection_rate",
          "statistic": "unweighted_mean_over_20_calibration_seeds",
          "direction": "higher"
        },
        {
          "order": 5,
          "action": "rank_remaining_ties",
          "endpoint_id": "endpoint.operational.review_burden",
          "statistic": "unweighted_mean_over_20_calibration_seeds",
          "direction": "lower"
        }
      ],
      "final_tie_breaker": "canonical_configuration_id_ascending",
      "missing_metric_action": "mark_candidate_ineligible",
      "no_eligible_action": "return_no_selection_without_relaxation",
      "post_hoc_rule_changes": "forbidden"
    }
  ],
  "clustering_endpoint_roles": {
    "co_primary_family_ids": [
      "family.clustering.synthetic"
    ],
    "key_secondary_endpoint_ids": [
      "endpoint.clustering.incident_split_loss",
      "endpoint.clustering.incident_merge_loss",
      "endpoint.operational.review_burden",
      "endpoint.secondary.destination_geographic_diameter_m",
      "endpoint.secondary.noise_rejection_rate"
    ]
  },
  "endpoints": [
    {
      "id": "endpoint.clustering.ari_labeled_reports",
      "direction": "higher",
      "unit": "score",
      "population": "synthetic_reports_with_incident_label",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.clustering.incident_split_loss",
      "direction": "lower",
      "unit": "loss",
      "population": "synthetic_incidents_with_reports",
      "denominator_required": true,
      "confirmatory": false
    },
    {
      "id": "endpoint.clustering.incident_merge_loss",
      "direction": "lower",
      "unit": "loss",
      "population": "emitted_operational_destinations_containing_linked_reports",
      "denominator_required": true,
      "confirmatory": false
    },
    {
      "id": "endpoint.operational.false_destinations_per_100_reports",
      "direction": "lower",
      "unit": "destinations_per_100_reports",
      "population": "all_synthetic_reports_including_noise",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.operational.review_burden",
      "direction": "lower",
      "unit": "decision_units",
      "population": "all_reports_and_destinations",
      "denominator_required": true,
      "confirmatory": false
    },
    {
      "id": "endpoint.secondary.noise_rejection_rate",
      "direction": "higher",
      "unit": "proportion",
      "population": "synthetic_noise_reports",
      "denominator_required": true,
      "confirmatory": false
    },
    {
      "id": "endpoint.secondary.destination_geographic_diameter_m",
      "direction": "lower",
      "unit": "metres",
      "population": "nontrivial_operational_destinations",
      "denominator_required": true,
      "confirmatory": false
    },
    {
      "id": "endpoint.priority.ndcg_at_5",
      "direction": "higher",
      "unit": "score",
      "population": "predicted_operational_units_with_post_scoring_one_to_one_evaluator_gains",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.priority.kendall_tau_b",
      "direction": "higher",
      "unit": "ordinal_correlation",
      "population": "predicted_operational_units_with_post_scoring_one_to_one_evaluator_gains",
      "denominator_required": true,
      "confirmatory": false
    },
    {
      "id": "endpoint.priority.top_k_recall",
      "direction": "higher",
      "unit": "proportion",
      "population": "predicted_operational_units_with_post_scoring_one_to_one_evaluator_gains",
      "denominator_required": true,
      "confirmatory": false
    },
    {
      "id": "endpoint.priority.rank_regret",
      "direction": "lower",
      "unit": "synthetic_benefit_units",
      "population": "predicted_operational_units_with_post_scoring_one_to_one_evaluator_gains",
      "denominator_required": true,
      "confirmatory": false
    },
    {
      "id": "endpoint.priority.normalized_drift",
      "direction": "lower",
      "unit": "normalized_absolute_change",
      "population": "observable_predicted_units_under_locked_perturbations",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.priority.top_k_churn",
      "direction": "lower",
      "unit": "proportion",
      "population": "stress_test_rankings",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.priority.false_priority_lift",
      "direction": "lower",
      "unit": "normalized_score_change",
      "population": "nonincident_campaign_reports",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.dispatch.latent_harm",
      "direction": "lower",
      "unit": "synthetic_outcome_units",
      "population": "synthetic_incidents",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.dispatch.deadline_miss_rate",
      "direction": "lower",
      "unit": "proportion",
      "population": "synthetic_incidents_with_deadline",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.external.trec_priority_kendall_tau_b",
      "direction": "higher",
      "unit": "ordinal_correlation",
      "population": "held_out_flood_or_hurricane_tweets_with_human_priority",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.external.trec_priority_ndcg_at_k",
      "direction": "higher",
      "unit": "ranking_score",
      "population": "held_out_flood_or_hurricane_event_streams",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.external.trec_high_critical_auprc",
      "direction": "higher",
      "unit": "area",
      "population": "held_out_flood_or_hurricane_tweets",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.external.crisisfacts_fact_comprehensiveness",
      "direction": "higher",
      "unit": "proportion",
      "population": "gold_event_day_facts",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.external.crisisfacts_unmatched_representative_rate",
      "direction": "lower",
      "unit": "proportion",
      "population": "emitted_event_day_representatives",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.external.idrisi_location_span_f1",
      "direction": "higher",
      "unit": "score",
      "population": "gold_location_mentions_in_flood_tweets",
      "denominator_required": true,
      "confirmatory": true
    },
    {
      "id": "endpoint.external.event_context_coverage",
      "direction": "higher",
      "unit": "proportion",
      "population": "eligible_noaa_or_uk_flood_incidents",
      "denominator_required": true,
      "confirmatory": false
    }
  ],
  "holm_families": [
    {
      "id": "family.clustering.synthetic",
      "procedure": "holm",
      "alpha": 0.05,
      "endpoint_ids": [
        "endpoint.clustering.ari_labeled_reports",
        "endpoint.operational.false_destinations_per_100_reports"
      ]
    },
    {
      "id": "family.priority_dispatch.synthetic",
      "procedure": "holm",
      "alpha": 0.05,
      "endpoint_ids": [
        "endpoint.priority.ndcg_at_5",
        "endpoint.priority.normalized_drift",
        "endpoint.priority.top_k_churn",
        "endpoint.priority.false_priority_lift",
        "endpoint.dispatch.latent_harm",
        "endpoint.dispatch.deadline_miss_rate"
      ]
    },
    {
      "id": "family.external.trec_priority",
      "procedure": "holm",
      "alpha": 0.05,
      "endpoint_ids": [
        "endpoint.external.trec_priority_kendall_tau_b",
        "endpoint.external.trec_priority_ndcg_at_k",
        "endpoint.external.trec_high_critical_auprc"
      ]
    },
    {
      "id": "family.external.crisisfacts_consolidation",
      "procedure": "holm",
      "alpha": 0.05,
      "endpoint_ids": [
        "endpoint.external.crisisfacts_fact_comprehensiveness",
        "endpoint.external.crisisfacts_unmatched_representative_rate"
      ]
    },
    {
      "id": "family.external.idrisi_location",
      "procedure": "holm",
      "alpha": 0.05,
      "endpoint_ids": [
        "endpoint.external.idrisi_location_span_f1"
      ]
    }
  ],
  "inference": {
    "confidence_interval": "paired_bootstrap_95_percent",
    "hypothesis_test": "paired_wilcoxon_signed_rank",
    "multiplicity_scope": "within_each_declared_family",
    "unfavorable_and_null_results_retained": true,
    "minimum_reported_fields": [
      "mean",
      "standard_deviation",
      "median",
      "paired_confidence_interval",
      "effect_size",
      "raw_p_value",
      "holm_adjusted_p_value",
      "denominator"
    ]
  },
  "claim_gates": [
    {
      "id": "claim.synthetic_controlled_clustering",
      "default_status": "eligible_after_evidence",
      "required_family_ids": [
        "family.clustering.synthetic"
      ],
      "required_source_gate_ids": [],
      "required_conditions": [
        "matching_protocol_hash",
        "single_untouched_confirmation_release",
        "each_method_selected_independently_by_common_one_se_rule",
        "all_denominators_and_null_results_reported"
      ],
      "permitted_scope": "within_frozen_synthetic_generator_family",
      "prohibited_inferences": [
        "real_flood_transfer",
        "operational_deployment_validity"
      ]
    },
    {
      "id": "claim.synthetic_duplicate_invariance",
      "default_status": "eligible_after_evidence",
      "required_family_ids": [
        "family.priority_dispatch.synthetic"
      ],
      "required_source_gate_ids": [],
      "required_conditions": [
        "exact_payload_duplicate_scenario_reported_separately",
        "coordinated_campaign_failure_scenario_retained"
      ],
      "permitted_scope": "algebraic_and_synthetic_stress_behavior",
      "prohibited_inferences": [
        "priority_accuracy",
        "misinformation_robustness"
      ]
    },
    {
      "id": "claim.synthetic_priority_alignment",
      "default_status": "eligible_after_evidence",
      "required_family_ids": [
        "family.priority_dispatch.synthetic"
      ],
      "required_source_gate_ids": [],
      "required_conditions": [
        "priority_scored_on_predicted_clusters_before_truth_join",
        "latent_benefit_generated_independently_of_priority_formula",
        "split_merge_noise_and_unmatched_units_retained",
        "strongest_simple_baseline_comparison_reported_on_id_and_ood"
      ],
      "permitted_scope": "construct_alignment_within_frozen_synthetic_generator_family",
      "prohibited_inferences": [
        "expert_validated_policy",
        "real_rescue_utility",
        "deployment_readiness"
      ]
    },
    {
      "id": "claim.external_priority_sanity",
      "default_status": "blocked",
      "required_family_ids": [
        "family.external.trec_priority"
      ],
      "required_source_gate_ids": [
        "gate.source.trec_is.access",
        "gate.source.trec_is.priority_coverage"
      ],
      "required_conditions": [
        "event_disjoint_evaluation",
        "human_priority_labels_not_used_to_construct_inputs"
      ],
      "permitted_scope": "alignment_with_human_information_criticality",
      "prohibited_inferences": [
        "dispatch_benefit",
        "harm_reduction"
      ]
    },
    {
      "id": "claim.external_consolidation_sanity",
      "default_status": "blocked",
      "required_family_ids": [
        "family.external.crisisfacts_consolidation"
      ],
      "required_source_gate_ids": [
        "gate.source.crisisfacts.access",
        "gate.source.crisisfacts.consolidation_coverage"
      ],
      "required_conditions": [
        "event_day_evaluation",
        "gold_facts_not_relabelled_as_physical_incidents"
      ],
      "permitted_scope": "redundancy_and_fact_retention_proxy",
      "prohibited_inferences": [
        "physical_incident_ari",
        "incident_split_or_merge_accuracy"
      ]
    },
    {
      "id": "claim.external_location_sanity",
      "default_status": "blocked",
      "required_family_ids": [
        "family.external.idrisi_location"
      ],
      "required_source_gate_ids": [
        "gate.source.idrisi_re.access",
        "gate.source.idrisi_re.location_coverage"
      ],
      "required_conditions": [
        "gold_location_mentions_held_out_by_event",
        "unresolved_mentions_not_treated_as_coordinates"
      ],
      "permitted_scope": "location_feature_extraction_transfer",
      "prohibited_inferences": [
        "geocoding_accuracy_without_disambiguation_gold",
        "physical_incident_clustering_accuracy"
      ]
    },
    {
      "id": "claim.external_flood_context_descriptive",
      "default_status": "blocked",
      "required_family_ids": [],
      "required_source_gate_ids": [
        "gate.source.noaa_storm_events.access",
        "gate.source.noaa_storm_events.event_coverage",
        "gate.source.uk_water_rescue.access",
        "gate.source.uk_water_rescue.outcome_coverage"
      ],
      "required_conditions": [
        "descriptive_only",
        "source_specific_missingness_reported"
      ],
      "permitted_scope": "event_context_and_outcome_distribution_sanity",
      "prohibited_inferences": [
        "report_clustering_validation",
        "priority_policy_validation"
      ]
    },
    {
      "id": "claim.real_incident_clustering_accuracy",
      "default_status": "blocked",
      "required_family_ids": [],
      "required_source_gate_ids": [],
      "required_conditions": [
        "independently_annotated_multi_report_physical_incident_ids",
        "adjudicated_duplicate_relations",
        "held_out_real_incidents"
      ],
      "permitted_scope": "none_until_new_authorized_annotation_exists",
      "prohibited_inferences": [
        "event_ids_as_incident_ids",
        "atomic_facts_as_incident_ids"
      ]
    },
    {
      "id": "claim.real_dispatch_benefit",
      "default_status": "blocked",
      "required_family_ids": [],
      "required_source_gate_ids": [],
      "required_conditions": [
        "independently_observed_dispatch_outcomes",
        "expert_validated_policy",
        "prospective_or_defensible_quasi_experimental_design"
      ],
      "permitted_scope": "none_for_current_public_sources",
      "prohibited_inferences": [
        "synthetic_harm_as_real_harm",
        "human_priority_as_dispatch_utility"
      ]
    },
    {
      "id": "claim.vietnamese_transfer",
      "default_status": "blocked",
      "required_family_ids": [],
      "required_source_gate_ids": [],
      "required_conditions": [
        "authorized_vietnamese_flood_rescue_reports",
        "vietnamese_annotation_and_error_analysis"
      ],
      "permitted_scope": "none_for_current_public_sources",
      "prohibited_inferences": [
