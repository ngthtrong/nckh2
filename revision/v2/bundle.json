{
  "schema_version": "v2.protocol-bundle.1",
  "bundle_id": "protocol.flood_rescue.v2",
  "frozen_members": [
    "analysis_contract.json",
    "method_registry.json",
    "public_anchor.json",
    "public_sources.json",
    "seed_partitions.json"
  ],
  "excluded_path_prefixes": [
    "results/"
  ],
  "excluded_files": [
    "protocol-lock.json"
  ],
  "hash_algorithm": "sha256",
  "hash_encoding": "sorted member-path to member-sha256 canonical JSON",
  "policy": {
    "results_are_never_protocol_inputs": true,
    "unlisted_files_are_not_hashed": true,
    "missing_frozen_member_is_fatal": true,
    "symlinked_frozen_member_is_forbidden": true
  }
}
