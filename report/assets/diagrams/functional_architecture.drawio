        <mxCell id="app_flutter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.8;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=top;spacingTop=6;fontColor=#172B4D;" value="&lt;div style=&quot;line-height:1;&quot;&gt;&lt;b&gt;Ứng dụng Di động (Flutter Client)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 12.5px; color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;• SOS &amp;amp; Báo cáo:&lt;/b&gt; 1 chạm GPS, Ảnh, N, V&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 12.5px; color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 12.5px; color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;• On-device Edge AI:&lt;/b&gt; MobileNetV3 (F); ExecuTorch, ONNX; Điểm khẩn cấp E_i&lt;br&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 12.5px; color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;• Hive Outbox &amp;amp; Ngoại tuyến:&lt;/b&gt; Store-and-Forward, JCS RFC 8785&lt;br&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 12.5px; color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;• Tiến độ ca:&lt;/b&gt; Tra cứu /reports/status &amp;amp; Tác nghiệp thực địa&lt;/div&gt;&lt;/div&gt;" vertex="1">
