        </mxCell>
        <mxCell id="sms_gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.2;fontSize=14;fontFamily=Helvetica;align=center;fontColor=#172B4D;spacing=0;spacing=0;" value="&lt;div style=&quot;line-height:1;&quot;&gt;&lt;b&gt;SMS GATEWAY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; line-height: 1; color: rgb(0, 0, 0);&quot;&gt;Thiết bị / Tổng đài GSM&lt;br&gt;Nhận SMS SOS &amp;amp; Chuyển tiếp Webhook&lt;/font&gt;&lt;/div&gt;" vertex="1">
