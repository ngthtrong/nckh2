  <diagram id="diag-1" name="Luu-do-Tiep-nhan-va-Chong-trung-Backend">
    <mxGraphModel dx="2348" dy="1304" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bd_start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontFamily=Helvetica;fontSize=15;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Nhận Request tới Backend&#xa;(Sync batch / Multipart / SMS)&lt;/div&gt;" vertex="1">
          <mxGeometry height="57" width="235" x="280" y="7" as="geometry" />
        </mxCell>
        <mxCell id="bd_header" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Kiểm tra header&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;line-height:1;&quot;&gt;bắt buộc:&lt;br&gt;X-Message-Contract-Version: 1&lt;/div&gt;" vertex="1">
          <mxGeometry height="83" width="206" x="294" y="84" as="geometry" />
        </mxCell>
        <mxCell id="bd_bounds" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Kiểm tra giới hạn kích thước:&#xa;- Batch &amp;lt;= 50 messages&#xa;- Tổng request &amp;lt;= 256 KiB&#xa;- Meta &amp;lt;= 64 KiB, Ảnh &amp;lt;= 15 MB&lt;/div&gt;" vertex="1">
          <mxGeometry height="83" width="377" x="209" y="191" as="geometry" />
        </mxCell>
        <mxCell id="bd_jcs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Chuẩn tắc hóa JSON theo RFC 8785&#xa;&amp;amp; Tính mã băm SHA-256 payload&lt;/div&gt;" vertex="1">
          <mxGeometry height="36" width="260" x="267" y="310" as="geometry" />
        </mxCell>
        <mxCell id="bd_lookup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Tra cứu bảng messages_dedup&#xa;theo message_id &amp;amp; client_id&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="190" x="302" y="371" as="geometry" />
        </mxCell>
        <mxCell id="bd_dedup_check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Kết quả đối chiếu&#xa;chống trùng lặp?&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="170" x="312.5" y="441" as="geometry" />
        </mxCell>
        <mxCell id="bd_dup_ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;TRÙNG MESSAGE_ID &amp;amp; HASH:&#xa;- Phát hiện mất ACK sau commit&#xa;- Trả duplicate + kết quả cũ&#xa;- Không sửa đổi CSDL (Idempotent)&lt;/div&gt;" vertex="1">
          <mxGeometry height="89.5" width="230" y="437" as="geometry" />
        </mxCell>
        <mxCell id="bd_err_conflict" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;TRÙNG ID KHÁC HASH HOẶC TÁI DÙNG SEQ:&#xa;- Trả lỗi 409 Conflict&#xa;- Mã ID_REUSED_WITH_DIFFERENT_PAYLOAD&#xa;  hoặc SEQUENCE_REUSED&lt;/div&gt;" vertex="1">
          <mxGeometry height="78" width="354" x="572" y="437" as="geometry" />
        </mxCell>
        <mxCell id="bd_new_tx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;THAO TÁC HỢP LỆ (MỚI):&#xa;Mở SQLite Database Transaction&#xa;Kiểm tra quyền sở hữu report_owner&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="239" x="280" y="545" as="geometry" />
        </mxCell>
        <mxCell id="bd_merge_check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Báo cáo đã có trong DB?&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="150" x="324.5" y="635" as="geometry" />
        </mxCell>
        <mxCell id="bd_merge_apply" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Báo cáo cũ (gộp dữ liệu):&#xa;- Chỉ bổ sung trường còn trống&#xa;- Gắn ảnh nếu trước đó chưa có ảnh&#xa;- Giữ nguyên ảnh đầu tiên và ngày tạo&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="277" x="101" y="712.5" as="geometry" />
        </mxCell>
        <mxCell id="bd_create_apply" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Báo cáo mới hoàn toàn:&#xa;- Tạo bản ghi mới trong bảng reports&#xa;- Trạng thái khởi tạo: processing&#xa;- Lưu file ảnh vật lý (nếu có)&lt;/div&gt;" vertex="1">
          <mxGeometry height="78" width="277" x="500" y="712.5" as="geometry" />
        </mxCell>
        <mxCell id="bd_commit" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=15;fontFamily=Helvetica;" value="&lt;div style=&quot;line-height:1;&quot;&gt;Commit Transaction:&#xa;- Ghi vết bảng messages_dedup&#xa;- Ghi nhật ký vào report_events&#xa;- Tăng server_meta version (báo cụm stale)&lt;/div&gt;" vertex="1">
          <mxGeometry height="86" width="329" x="235" y="801" as="geometry" />
        </mxCell>
