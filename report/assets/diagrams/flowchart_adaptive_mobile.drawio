<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-Gui-Bao-cao-Thich-ung-App"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="am_start" value="Khởi tạo Báo cáo&#10;(SOS / Post)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="340" y="40" width="160" height="45" as="geometry" /></mxCell><mxCell id="am_img_dec" value="Người dùng có&#10;đính kèm ảnh?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="350" y="115" width="140" height="65" as="geometry" /></mxCell><mxCell id="am_ai" value="Edge AI MobileNetV3 suy luận:&#10;- Nhãn ngập: non/low/med/high&#10;- Confidence score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#D81B60;" parent="1" vertex="1"><mxGeometry x="160" y="210" width="200" height="55" as="geometry" /></mxCell><mxCell id="am_no_img" value="Không có ảnh:&#10;Gán nhãn non_flood mặc định" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="480" y="215" width="180" height="45" as="geometry" /></mxCell><mxCell id="am_fields" value="Nhập thông tin cứu hộ:&#10;- Tọa độ GPS (hoặc để trống/nhập tay)&#10;- Số người kẹt, số người bị thương&#10;- Nhóm yếu thế (người già, trẻ nhỏ...)&#10;- Tự động tính Urgency Score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="310" y="295" width="220" height="75" as="geometry" /></mxCell><mxCell id="am_hive" value="Ghi ngay vào Hive Outbox&#10;(Store-and-forward cục bộ)&#10;Trạng thái: pending" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;" parent="1" vertex="1"><mxGeometry x="345" y="395" width="150" height="60" as="geometry" /></mxCell><mxCell id="am_probe" value="Gọi GET /probe (64 KB)&#10;Đo thông lượng mạng thực tế (kbps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="485" width="180" height="45" as="geometry" /></mxCell><mxCell id="am_net_eval" value="Phân loại thông lượng&#10;&amp; Điều kiện gửi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="560" width="180" height="75" as="geometry" /></mxCell><mxCell id="am_sms" value="MẤT MẠNG HOÀN TOÀN:&#10;- Kiểm tra số hotline SMS Android&#10;- Gửi tin SOS|id:... qua SMS&#10;- Giữ bản ghi trong Outbox chờ mạng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#FFEBEE;strokeColor=#E53935;" parent="1" vertex="1"><mxGeometry x="40" y="670" width="200" height="65" as="geometry" /></mxCell><mxCell id="am_meta" value="MẠNG YẾU (&lt;50 kbps)&#10;hoặc (Mạnh &amp; Conf &gt;= 0.90):&#10;- Gửi metadata JSON qua&#10;  POST /sync/messages (&lt;=256 KB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="265" y="670" width="190" height="65" as="geometry" /></mxCell><mxCell id="am_comp" value="MẠNG TRUNG BÌNH (50-1000 kbps):&#10;- Nén JPEG (max 1024px, q=60)&#10;- Gửi multipart qua POST /api/reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#FFF8E1;strokeColor=#F57C00;" parent="1" vertex="1"><mxGeometry x="480" y="670" width="200" height="65" as="geometry" /></mxCell><mxCell id="am_orig" value="MẠNG MẠNH (&gt;=1000 kbps &amp; Conf&lt;0.9):&#10;- Giữ nguyên ảnh gốc&#10;- Gửi multipart POST /api/reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#4CAF50;" parent="1" vertex="1"><mxGeometry x="705" y="670" width="210" height="65" as="geometry" /></mxCell><mxCell id="am_res" value="Nhận phản hồi từ Server:&#10;- accepted: Xóa khỏi Outbox, synced=true&#10;- duplicate: Dùng kết quả cũ, synced=true&#10;- retry_later / lỗi mạng: Backoff retry&#10;- rejected: Chuyển dead-letter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="775" width="220" height="75" as="geometry" /></mxCell><mxCell id="am_poll" value="Khởi động Timer Polling 15s:&#10;Gọi GET /api/reports/status&#10;để nhận cập nhật tiến trình điều phối" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="875" width="220" height="50" as="geometry" /></mxCell><mxCell id="am_end" value="Hoàn tất luồng client" style="ellipse;whiteSpace=wrap;html=1;fillColor=#607D8B;strokeColor=#37474F;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="390" y="950" width="100" height="40" as="geometry" /></mxCell><mxCell id="ae_1" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_start" target="am_img_dec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_2" value="Có ảnh" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_img_dec" target="am_ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_3" value="Không ảnh" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_img_dec" target="am_no_img"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_4" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_ai" target="am_fields"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_5" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_no_img" target="am_fields"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_6" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_fields" target="am_hive"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_7" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_hive" target="am_probe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_8" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_probe" target="am_net_eval"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_9" value="Mất data" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_net_eval" target="am_sms"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_10" value="&lt;50 kbps" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_net_eval" target="am_meta"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_11" value="50-1000 kbps" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_net_eval" target="am_comp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_12" value="&gt;=1000 kbps" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_net_eval" target="am_orig"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_13" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_sms" target="am_res"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_14" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_meta" target="am_res"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_15" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_comp" target="am_res"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_16" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_orig" target="am_res"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_17" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_res" target="am_poll"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ae_18" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="am_poll" target="am_end"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>