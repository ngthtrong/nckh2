<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-02-Tao-Bao-cao-Edge-AI"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="40" width="100" height="40" as="geometry" /></mxCell><mxCell id="open_form" value="Mở biểu mẫu&#10;'Tạo Báo cáo Cứu hộ'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="110" width="180" height="50" as="geometry" /></mxCell><mxCell id="img_dec" value="Người dùng có&#10;đính kèm ảnh?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="350" y="190" width="140" height="65" as="geometry" /></mxCell><mxCell id="capture" value="Chụp ảnh hiện trường&#10;hoặc chọn từ thư viện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="130" y="280" width="200" height="50" as="geometry" /></mxCell><mxCell id="run_ai" value="AnalyzeImageUseCase:&#10;Chạy MobileNetV3 On-device&#10;(ONNX Runtime / ExecuTorch .pte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="130" y="360" width="200" height="65" as="geometry" /></mxCell><mxCell id="ai_out" value="Trích xuất kết quả AI:&#10;Nhãn ngập (non/low/med/high)&#10;&amp; Điểm tin cậy (Confidence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontS