er" value="Chuyển sang chính sách&#10;gửi thích ứng (deliverRecord)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="970" width="200" height="50" as="geometry" /></mxCell><mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#607D8B;strokeColor=#37474F;fontColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="380" y="1050" width="100" height="40" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="start" target="open_form"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="open_form" target="img_dec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Có ảnh" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="img_dec" target="capture"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Không" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="img_dec" target="skip_ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="capture" target="run_ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="run_ai" target="ai_out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="endArrow=classic;html=1;stro