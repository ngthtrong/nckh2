<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-09-Pipeline-Huan-luyen-va-Toi-uu-AI"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="450" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="grp_phase1" value="GIAI ĐOẠN 1: CHUẨN BỊ DỮ LIỆU &amp; THIẾT KẾ KIẾN TRÚC" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;spacingTop=6;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="30" y="30" width="1080" height="115" as="geometry" /></mxCell><mxCell id="grp_phase2" value="GIAI ĐOẠN 2: HUẤN LUYỆN 2 GIAI ĐOẠN &amp; CHỌN CHECKPOINT TỐI ƯU" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;spacingTop=6;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="30" y="165" width="1080" height="115" as="geometry" /></mxCell><mxCell id="grp_phase3" value="GIAI ĐOẠN 3: ĐÁNH GIÁ ĐỘC LẬP, TỐI ƯU NÉN &amp; XUẤT RUNTIME KÉP" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;spacingTop=6;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="30" y="300" width="1080" height="115" as="geometry" /></mxCell><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="50" y="78" width="70" height="38" as="geometry" /></mxCell><mxCell id="dataset" value="Tập dữ liệu ảnh bão lũ cứu hộ:&#10;1.702 mẫu ảnh (4 mức ngập:&#10;non_flood, low, medium, high)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="140" y="65" width="200" height="65" as="geometry" /></mxCell><mxCell id="strat_split" value="Phân chia Stratified Split (Seed 42):&#10;- Train Set (70%): ~1.192 ảnh&#10;- Validation Set (15%): ~254 ảnh&#10;- Test Set độc lập (15%): 256 ảnh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="65" width="220" height="65" as="geometry" /></mxCell><mxCell id="augment" value="Tiền xử lý &amp; Tăng cường ảnh:&#10;- Letterbox Resize 256x256 RGB&#10;- RandomHorizontalFlip, ColorJitter&#10;- Normalization ImageNet stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="620" y="65" width="220" height="65" as="geometry" /></mxCell><mxCell id="init_arch" value="MobileNetV3-Large Backbone&#10;Thay thế Classifier Head tùy biến:&#10;Dropout(0.25) -&gt; Linear(1280, 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="870" y="65" width="220" height="65" as="geometry" /></mxCell><mxCell id="phase1" value="Pha 1: Khóa Backbone (eval mode)&#10;Huấn luyện Classifier Head&#10;(3 epoch khởi tạo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="870" y="200" width="220" height="65" as="geometry" /></mxCell><mxCell id="phase2" value="Pha 2: Mở toàn bộ mạng&#10;Fine-tuning AdamW + CosineAnnealing&#10;Loss: CrossEntropy + 0.1 SeverityLoss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="620" y="200" width="220" height="65" as="geometry" /></mxCell><mxCell id="val_check" value="Đánh giá Validation Set:&#10;Val Loss &amp; Tỷ lệ lỗi nặng&#10;(Early Stopping patience=7)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="380" y="200" width="200" height="65" as="geometry" /></mxCell><mxCell id="best_ckpt" value="Lưu Checkpoint tối ưu nhất&#10;(Accuracy: ~75.78%,&#10;Macro-F1: ~74.26%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="140" y="200" width="200" height="65" as="geometry" /></mxCell><mxCell id="test_eval" value="Đánh giá trên Test Set độc lập:&#10;- 256 ảnh kiểm định độc lập&#10;- Confusion Matrix &amp; Macro-F1&#10;- Kiểm tra tỷ lệ lỗi nghiêm trọng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="140" y="335" width="200" height="65" as="geometry" /></mxCell><mxCell id="pruning_opt" value="Tối ưu hóa nén mô hình:&#10;- Cắt tỉa kênh L1 Pruning (tỷ lệ 1%)&#10;- Lượng tử hóa INT8 (PTQ/QAT QDQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="335" width="220" height="65" as="geometry" /></mxCell><mxCell id="export_dual" value="Xuất định dạng Runtime di động kép:&#10;1) ONNX Model (.onnx) qua onnxruntime&#10;2) ExecuTorch Program (.pte) di động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="620" y="335" width="220" height="65" as="geometry" /></mxCell><mxCell id="mobile_deploy" value="Tích hợp Flutter Edge App:&#10;Suy luận On-device thời gian thực&#10;(Hoạt động hoàn toàn Offline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="870" y="335" width="155" height="65" as="geometry" /></mxCell><mxCell id="end" value="Sẵn sàng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="1045" y="348" width="65" height="38" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="start" target="dataset"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="dataset" target="strat_split"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="strat_split" target="augment"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="augment" target="init_arch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="init_arch" target="phase1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="phase1" target="phase2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="phase2" target="val_check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Đạt chuẩn" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="val_check" target="best_ckpt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="best_ckpt" target="test_eval"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="test_eval" target="pruning_opt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="pruning_opt" target="export_dual"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="export_dual" target="mobile_deploy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="mobile_deploy" target="end"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>