<mxfile host="Electron" agent="Antigravity"><diagram id="diag-usecase-mobile" name="So-do-Use-Case-Chi-tiet-Mobile-App"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="790" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys_bound" value="PHÂN HỆ DI ĐỘNG BIÊN (EDGE MOBILE APP - FLUTTER)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=32;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="850" height="710" as="geometry" /></mxCell><mxCell id="uc_01" value="UC-01: Gửi yêu cầu SOS khẩn cấp&amp;#xa;(1 chạm, tọa độ GPS &amp; mã thiết bị)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="35" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_02" value="UC-02: Tạo báo cáo cứu hộ chi tiết&amp;#xa;(số người kẹt, bị thương, nhóm yếu thế)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="125" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_06" value="UC-06: Tra cứu trạng thái cứu hộ&amp;#xa;(tiến trình xử lý &amp; phản hồi thực địa)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="215" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_09m" value="UC-09M: Tra cứu cẩm nang &amp; điểm trú&amp;#xa;(bản đồ vùng an toàn &amp; kỹ năng sinh tồn)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00