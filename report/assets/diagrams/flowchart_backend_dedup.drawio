<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-Tiep-nhan-va-Chong-trung-Backend"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bd_start" value="Nhận Request tới Backend&#10;(Sync batch / Multipart / SMS)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="330" y="40" width="180" height="45" as="geometry" /></mxCell><mxCell id="bd_header" value="Kiểm tra header bắt buộc:&#10;X-Message-Contract-Version: 1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="340" y="110" width="160" height="65" as="geometry" /></mxCell><mxCell id="bd_bounds" value="Kiểm tra giới hạn kích thước:&#10;- Batch &lt;= 50 messages&#10;- Tổng request &lt;= 256 KiB&#10;- Meta &lt;= 64 KiB, Ảnh &lt;= 15 MB" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="200" width="180" height="70" as="geometry" /></mxCell><mxCell id="bd_jcs" value="Chuẩn tắc hóa JSON theo RFC 8785&#10;&amp; Tính mã băm SHA-256 payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="325" y="295" width="190" height="50" as="geometry" /></mxCell><mxCell id="bd_lookup" value="Tra cứu bảng messages_dedup&#10;theo message_id &amp; client_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;fillColor=#EDE7F6;" parent="1" vertex="1"><mxGeometry x="325" y="370" width="190" height="50" as="geometry" /></mxCell><mxCell id="bd_dedup_check" value="Kết quả đối chiếu&#10;chống trùng lặp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="335" y="445" width="170" height="70" as="geometry" /></mxCell><mxCell id="bd_dup_ok" value="TRÙNG MESSAGE_ID &amp; HASH:&#10;- Phát hiện mất ACK sau commit&#10;- Trả duplicate + kết quả cũ&#10;- Không sửa đổi CSDL (Idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#4CAF50;" parent="1" vertex="1"><mxGeometry x="40" y="545" width="210" height="65" as="geometry" /></mxCell><mxCell id="bd_err_conflict" value="TRÙNG ID KHÁC HASH HOẶC TÁI DÙNG SEQ:&#10;- Trả lỗi 409 Conflict&#10;- Mã ID_REUSED_WITH_DIFFERENT_PAYLOAD&#10;  hoặc SEQUENCE_REUSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;fillColor=#FFEBEE;strokeColor=#E53935;" parent="1" vertex="1"><mxGeometry x="600" y="545" width="230" height="65" as="geometry" /></mxCell><mxCell id="bd_new_tx" value="THAO TÁC HỢP LỆ (MỚI):&#10;Mở SQLite Database Transaction&#10;Kiểm tra quyền sở hữu report_owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="325" y="545" width="190" height="65" as="geometry" /></mxCell><mxCell id="bd_merge_check" value="Báo cáo đã có trong DB?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="345" y="635" width="150" height="65" as="geometry" /></mxCell><mxCell id="bd_merge_apply" value="Báo cáo cũ (gộp dữ liệu):&#10;- Chỉ bổ sung trường còn trống&#10;- Gắn ảnh nếu trước đó chưa có ảnh&#10;- Giữ nguyên ảnh đầu tiên và ngày tạo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="150" y="725" width="220" height="65" as="geometry" /></mxCell><mxCell id="bd_create_apply" value="Báo cáo mới hoàn toàn:&#10;- Tạo bản ghi mới trong bảng reports&#10;- Trạng thái khởi tạo: processing&#10;- Lưu file ảnh vật lý (nếu có)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="470" y="725" width="220" height="65" as="geometry" /></mxCell><mxCell id="bd_commit" value="Commit Transaction:&#10;- Ghi vết bảng messages_dedup&#10;- Ghi nhật ký vào report_events&#10;- Tăng server_meta version (báo cụm stale)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;" parent="1" vertex="1"><mxGeometry x="320" y="820" width="200" height="70" as="geometry" /></mxCell><mxCell id="bd_ack" value="Trả phản hồi HTTP cho Client&#10;(accepted / 201 Created)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#2E7D32;" parent="1" vertex="1"><mxGeometry x="340" y="915" width="160" height="45" as="geometry" /></mxCell><mxCell id="bd_end" value="Kết thúc xử lý" style="ellipse;whiteSpace=wrap;html=1;fillColor=#607D8B;strokeColor=#37474F;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="370" y="985" width="100" height="40" as="geometry" /></mxCell><mxCell id="bd_err_bad" value="Trả lỗi 400 Bad Request&#10;(UNSUPPORTED_CONTRACT_VERSION&#10;hoặc REQUEST_TOO_LARGE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;fillColor=#FFEBEE;strokeColor=#E53935;" parent="1" vertex="1"><mxGeometry x="600" y="155" width="230" height="60" as="geometry" /></mxCell><mxCell id="bde_1" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_start" target="bd_header"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_2" value="Sai version" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_header" target="bd_err_bad"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_3" value="Đúng version" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_header" target="bd_bounds"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_4" value="Vượt kích thước" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_bounds" target="bd_err_bad"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_5" value="Hợp lệ" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_bounds" target="bd_jcs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_6" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_jcs" target="bd_lookup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_7" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_lookup" target="bd_dedup_check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_8" value="Duplicate" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_dedup_check" target="bd_dup_ok"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_9" value="Xung đột" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_dedup_check" target="bd_err_conflict"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_10" value="Hợp lệ" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_dedup_check" target="bd_new_tx"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_11" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_new_tx" target="bd_merge_check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_12" value="Đã có id" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_merge_check" target="bd_merge_apply"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_13" value="Chưa có" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_merge_check" target="bd_create_apply"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_14" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_merge_apply" target="bd_commit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_15" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_create_apply" target="bd_commit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_16" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_commit" target="bd_ack"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_17" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_ack" target="bd_end"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_18" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_dup_ok" target="bd_end"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_19" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_err_conflict" target="bd_end"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bde_20" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="bd_err_bad" target="bd_end"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>