<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-06-Phan-cum-va-Uu-tien"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="390" y="40" width="100" height="40" as="geometry" /></mxCell><mxCell id="trigger" value="Kích hoạt Phân cụm:&#10;- Polling từ Web Dashboard&#10;- Thay đổi version trong server_meta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="110" width="220" height="55" as="geometry" /></mxCell><mxCell id="etag_dec" value="So sánh ETag /&#10;cluster_version?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="195" width="140" height="65" as="geometry" /></mxCell><mxCell id="ret_304" value="Không đổi: Trả 304 Not Modified&#10;(Tận dụng Client Cache, giảm tải CPU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="610" y="200" width="220" height="55" as="geometry" /></mxCell><mxCell id="fetch_active" value="Dữ liệu mới: Truy vấn SQLite&#10;Lấy báo cáo active_only=True&#10;(Loại bỏ resolved &amp; cancelled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="290" width="220" height="60" as="geometry" /></mxCell><mxCell id="adapter_v2" value="Adapter to_report_v2:&#10;Trích xuất [F, U, N, V]&#10;&amp; Tọa độ địa lý (lat, lng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="380" width="220" height="60" as="geometry" /></mxCell><mxCell id="gps_dec" value="Báo cáo có&#10;tọa độ GPS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="470" width="140" height="65" as="geometry" /></mxCell><mxCell id="to_review" value="THIẾU GPS:&#10;Đưa vào Hàng xem xét (Review Queue)&#10;để điều phối viên xác minh thủ công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="100" y="565" width="230" height="65" as="geometry" /></mxCell><mxCell id="build_graph" value="CÓ GPS:&#10;Xây ma trận tương đồng C_ij&#10;(Khoảng cách Haversine, ngập F, khẩn cấp U)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="450" y="565" width="250" height="65" as="geometry" /></mxCell><mxCell id="louvain" value="Thuật toán Phân cụm Louvain:&#10;- Tối ưu hóa Modularité mạng lưới&#10;- Xác định clusterKey (ID nhỏ nhất)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="450" y="665" width="250" height="65" as="geometry" /></mxCell><mxCell id="score_calc" value="Tính điểm ưu tiên cụm P(c):&#10;P(c) = w1*Nc + w2*Vc + w3*Fc + w4*Uc&#10;Sắp xếp thứ bậc ưu tiên điều phối" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="450" y="765" width="250" height="65" as="geometry" /></mxCell><mxCell id="save_cache" value="Lưu Snapshot Cache &amp; ETag mới&#10;(Cập nhật cluster_version)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="860" width="220" height="55" as="geometry" /></mxCell><mxCell id="resp_dash" value="Trả dữ liệu JSON cho Dashboard:&#10;Danh sách cụm ưu tiên &amp; Review Queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="945" width="220" height="50" as="geometry" /></mxCell><mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#607D8B;strokeColor=#37474F;fontColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="390" y="1025" width="100" height="40" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="start" target="trigger"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="trigger" target="etag_dec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Không đổi" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="etag_dec" target="ret_304"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Có đổi" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="etag_dec" target="fetch_active"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="fetch_active" target="adapter_v2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" 