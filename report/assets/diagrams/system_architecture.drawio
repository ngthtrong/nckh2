<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Kien-truc-Tong-the-3-Tang-NCKH"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="825" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="tier1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 4;arcSize=8;fontSize=18;" parent="1" vertex="1"><mxGeometry x="40" y="25" width="1180" height="170" as="geometry" /></mxCell><mxCell id="tier1_label" value="&lt;b&gt;Tier 1: Thiết bị Di động Biên &amp;amp; Edge AI (Flutter 3 / Android Client)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="50" y="28" width="600" height="26" as="geometry" /></mxCell><mxCell id="ui_sos" value="&lt;b&gt;SOS Khẩn cấp 1 chạm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Định vị GPS tức thời&lt;br&gt;• Gói tin cứu nạn tối giản&lt;br&gt;• Ưu tiên phát tin khẩn cấp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="65" y="65" width="250" height="110" as="geometry" /></mxCell><mxCell id="ui_report" value="&lt;b&gt;Báo cáo Đa phương thức&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Chụp ảnh ngập + Tọa độ&lt;br&gt;• Số người mắc kẹt (N)&lt;br&gt;• Nhóm yếu thế &amp;amp; thương tích (V)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="360" y="65" width="250" height="110" as="geometry" /></mxCell><mxCell id="ai_edge" value="&lt;b&gt;Suy luận Edge AI On-device&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• MobileNetV3-Large (256×256)&lt;br&gt;• Phân loại 4 mức ngập (F) &amp;amp; U&lt;br&gt;• ONNX Dart &amp;amp; ExecuTorch JNI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="655" y="65" width="250" height="110" as="geometry" /></mxCell><mxCell id="hive_outbox" value="&lt;b&gt;Hive Outbox &amp;amp; Toàn vẹn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Store-and-Forward chống mất tin&lt;br&gt;• RFC 8785 Canonical JCS&lt;br&gt;• Toàn vẹn mã băm SHA-256&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="950" y="65" width="250" height="110" as="geometry" /></mxCell><mxCell id="trans_node" value="&lt;b&gt;Bộ Điều phối Kênh Truyền Thích ứng (Adaptive Network &amp;amp; Transport Channels)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;Kênh IP (4G/LTE/Wi-Fi): REST Batch (≤50 msg), Multipart Upload ảnh, GET /probe (64 KB)   |   Kênh GSM: SMS SOS Fallback dự phòng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontFamily=Helvetica;arcSize=10;" parent="1" vertex="1"><mxGeometry x="65" y="225" width="1135" height="48" as="geometry" /></mxCell><mxCell id="tier2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 4;arcSize=8;fontSize=18;" parent="1" vertex="1"><mxGeometry x="40" y="300" width="1180" height="175" as="geometry" /></mxCell><mxCell id="tier2_label" value="&lt;b&gt;Tier 2: Máy chủ Tiếp nhận &amp;amp; Xử lý Nghiệp vụ Lõi (FastAPI Backend Core &amp;amp; rescue_core Engine)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="50" y="304" width="720" height="26" as="geometry" /></mxCell><mxCell id="be_core" value="&lt;b&gt;Lõi Đồ thị &amp;amp; Phân cụm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Ma trận tương đồng C_ij&lt;br&gt;• Phân cụm Louvain (Modularity Q)&lt;br&gt;• Điểm ưu tiên cụm P(c)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="65" y="340" width="250" height="115" as="geometry" /></mxCell><mxCell id="be_review" value="&lt;b&gt;Hàng xem xét (Review Queue)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Tách riêng ca thiếu GPS&lt;br&gt;• Thẩm tra &amp;amp; gọi điện xác minh&lt;br&gt;• Tránh suy diễn tọa độ sai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="360" y="340" width="250" height="115" as="geometry" /></mxCell><mxCell id="be_dedup" value="&lt;b&gt;Toàn vẹn &amp;amp; Dedup Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Header X-Message-Contract: 1&lt;br&gt;• RFC 8785 Canonical JCS Hash&lt;br&gt;• Idempotency qua messages_dedup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="655" y="340" width="250" height="115" as="geometry" /></mxCell><mxCell id="be_api" value="&lt;b&gt;Cổng Tiếp nhận (API Gateway)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• POST /sync/messages (Batch)&lt;br&gt;• POST /api/reports (Multipart)&lt;br&gt;• Webhook POST /api/sms/inbound&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="950" y="340" width="250" height="115" as="geometry" /></mxCell><mxCell id="tier3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 4;arcSize=8;fontSize=18;" parent="1" vertex="1"><mxGeometry x="40" y="525" width="1180" height="210" as="geometry" /></mxCell><mxCell id="tier3_label" value="&lt;b&gt;Tier 3: Bàn Điều phối Web GIS &amp;amp; Lưu trữ Dữ liệu Bền vững&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#000000;&quot;&gt;(Dashboard Leaflet GIS &amp;amp; Persistent SQLite WAL Engine)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=14;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="55" y="686" width="300" height="32" as="geometry" /></mxCell><mxCell id="d_map" value="&lt;b&gt;Bản đồ Giám sát Leaflet GIS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Leaflet GIS đóng gói cục bộ&lt;br&gt;• Ranh giới cụm &amp;amp; Màu ưu tiên&lt;br&gt;• Chấm gán tọa độ thủ công&lt;br&gt;• Polling đồng bộ 5s (/changes)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="65" y="545" width="250" height="130" as="geometry" /></mxCell><mxCell id="d_dispatch" value="&lt;b&gt;Bảng Cụm &amp;amp; Điều phối Ca&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Thứ bậc ưu tiên giảm dần P(c)&lt;br&gt;• Khóa clusterKey nhất quán khi poll&lt;br&gt;• Giao đội (/team) &amp;amp; 4 trạng thái&lt;br&gt;• Nhật ký kiểm toán report_events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="360" y="545" width="250" height="130" as="geometry" /></mxCell><mxCell id="db_sqlite" value="&lt;b&gt;Cơ sở Dữ liệu SQLite WAL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• reports: Báo cáo &amp;amp; trạng thái&lt;br&gt;• messages_dedup: Chống trùng&lt;br&gt;• report_events: Lịch sử điều phối&lt;br&gt;• teams, operators, sessions, meta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="655" y="545" width="250" height="130" as="geometry" /></mxCell><mxCell id="fs_uploads" value="&lt;b&gt;Kho Lưu trữ Tệp Hiện trường&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#000000;&quot;&gt;• Thư mục uploads/ ảnh JPEG&lt;br&gt;• Lưu ảnh gốc &amp;amp; ảnh nén hiện trường&lt;br&gt;• Đối soát toàn vẹn SHA-256&lt;br&gt;• Static Server trả ảnh tức thời&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;arcSize=12;fillColor=#FFFFFF;strokeColor=#000000;" parent="1" vertex="1"><mxGeometry x="950" y="545" width="250" height="130" as="geometry" /></mxCell><mxCell id="legend_box" value="&lt;font style=&quot;font-size:11px;color:#000000;&quot;&gt;&lt;b&gt;CHÚ GIẢI QUY ƯỚC DÒNG DỮ LIỆU:&lt;/b&gt;   &lt;font color=&quot;#000000&quot;&gt;━━━ &lt;b&gt;Xanh Dương&lt;/b&gt;: Luồng dữ liệu Thiết bị Biên (Tier 1)&lt;/font&gt;   |   &lt;font color=&quot;#000000&quot;&gt;━━━ &lt;b&gt;Tím&lt;/b&gt;: Luồng xử lý Lõi Backend (Tier 2)&lt;/font&gt;   |   &lt;font color=&quot;#000000&quot;&gt;━━━ &lt;b&gt;Cam&lt;/b&gt;: Luồng Điều phối Web &amp;amp; GIS (Tier 3)&lt;/font&gt;   |   &lt;font color=&quot;#000000&quot;&gt;━━━ &lt;b&gt;Xanh Lá&lt;/b&gt;: Giao dịch CSDL &amp;amp; Giao đội&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;align=center;" parent="1" vertex="1"><mxGeometry x="40" y="770" width="1180" height="30" as="geometry" /></mxCell><mxCell id="e_report_ai" value="Ảnh &amp;amp; Meta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ui_report" target="ai_edge"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ai_outbox" value="[F, U, N, V]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="ai_edge" target="hive_outbox"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_sos_trans" value="Gói SOS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.11;entryY=0.0;entryDx=0;entryDy=0;" parent="1" edge="1" source="ui_sos" target="trans_node"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_outbox_trans" value="Đồng bộ Outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.89;entryY=0.0;entryDx=0;entryDy=0;" parent="1" edge="1" source="hive_outbox" target="trans_node"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_trans_api" value="HTTP REST &amp;amp; Webhook SMS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.89;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" parent="1" edge="1" source="trans_node" target="be_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_api_dedup" value="Xác thực Hợp đồng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="be_api" target="be_dedup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_dedup_rev" value="Báo cáo Hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="be_dedup" target="be_review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_rev_core" value="Đủ GPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="be_review" target="be_core"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_core_map" value="Cụm Louvain (ETag 304)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" parent="1" edge="1" source="be_core" target="d_map"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-8" /></mxGeometry></mxCell><mxCell id="e_rev_dispatch" value="Ca Thẩm tra &amp;amp; Điểm P(c)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" parent="1" edge="1" source="be_review" target="d_dispatch"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-8" /></mxGeometry></mxCell><mxCell id="e_dedup_db" value="Giao dịch WAL Mode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" parent="1" edge="1" source="be_dedup" target="db_sqlite"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-8" /></mxGeometry></mxCell><mxCell id="e_api_uploads" value="Lưu trữ Ảnh Hiện trường" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" parent="1" edge="1" source="be_api" target="fs_uploads"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-8" /></mxGeometry></mxCell><mxCell id="e_dispatch_team" value="Giao Đội (/team)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#000000;endArrow=block;endFill=1;fontSize=12;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="d_dispatch" target="be_api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="485" y="748" /><mxPoint x="1245" y="748" /><mxPoint x="1245" y="402" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>