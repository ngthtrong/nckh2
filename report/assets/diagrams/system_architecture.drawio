<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Kien-truc-Tong-the-He-thong"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="tier_mobile" value="TẦNG THIẾT BỊ DI ĐỘNG BIÊN (EDGE MOBILE CLIENT - FLUTTER)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#EBF3FA;strokeColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="40" y="40" width="460" height="880" as="geometry" /></mxCell><mxCell id="tier_backend" value="TẦNG MÁY CHỦ TIẾP NHẬN &amp; XỬ LÝ LÕI (FASTAPI BACKEND CORE)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#F3E5F5;strokeColor=#6A1B9A;" parent="1" vertex="1"><mxGeometry x="540" y="40" width="540" height="880" as="geometry" /></mxCell><mxCell id="tier_dashboard" value="TẦNG ĐIỀU PHỐI &amp; QUẢN TRỊ WEB (DISPATCH DASHBOARD)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFF8E1;strokeColor=#F57C00;" parent="1" vertex="1"><mxGeometry x="1120" y="40" width="440" height="880" as="geometry" /></mxCell><mxCell id="m_ui" value="Giao diện Người dùng (Presentation):&#10;- Màn hình SOS khẩn cấp (1 chạm)&#10;- Biểu mẫu Báo cáo Cứu hộ chi tiết&#10;- Màn hình Tra cứu tiến trình Cứu hộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="tier_mobile" vertex="1"><mxGeometry x="30" y="50" width="400" height="70" as="geometry" /></mxCell><mxCell id="m_ctrl" value="Tầng Logic &amp; Quản lý Trạng thái:&#10;- FormController, LocationController&#10;- ConnectivityMonitor &amp; ThroughputEvaluator&#10;- StatusPollingController (15s polling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="tier_mobile" vertex="1"><mxGeometry x="30" y="150" width="400" height="70" as="geometry" /></mxCell><mxCell id="m_ai_eng" value="Bộ Suy luận On-device AI (Edge AI Engine):&#10;- MobileNetV3-Large Backbone (256x256)&#10;- Custom Head phân loại 4 mức ngập (non/low/med/high)&#10;- Runtime kép: ONNX Runtime Dart &amp; ExecuTorch (.pte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#D81B60;fontSize=11;fontFamily=Helvetica;" parent="tier_mobile" vertex="1"><mxGeometry x="30" y="250" width="400" height="85" as="geometry" /></mxCell><mxCell id="m_hive_store" value="Lưu trữ Ngoại tuyến Outbox (Hive Store-and-Forward):&#10;- Hàng đợi Outbox Box (JSON RFC 8785 Canonical SHA-256)&#10;- Cache bản ghi cứu hộ &amp; tiến trình trạng thái cục bộ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontFamily=Helvetica;" parent="tier_mobile" vertex="1"><mxGeometry x="30" y="365" width="400" height="75" as="geometry" /></mxCell><mxCell id="m_bridge" value="Cầu nối Phần cứng &amp; Nền tảng (Platform Channels):&#10;- Định vị GPS (Geolocator)&#10;- SMS Telephony Bridge (Android SMS Manager)&#10;- WorkManager (Lịch trình đồng bộ ngầm khi có mạng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=11;fontFamily=Helvetica;" parent="tier_mobile" vertex="1"><mxGeometry x="30" y="470" width="400" height="75" as="geometry" /></mxCell><mxCell id="be_api" value="API Ingestion &amp; Webhook Endpoints:&#10;- POST /sync/messages (JSON batch &lt;= 50, idempotency)&#10;- POST /api/reports (Multipart Image + JSON metadata)&#10;- GET /probe (64 KB Network Bandwidth Probe)&#10;- POST /api/sms/inbound (SMS Gateway Webhook)&#10;- GET /api/reports/status (Status polling endpoint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="tier_backend" vertex="1"><mxGeometry x="30" y="50" width="480" height="95" as="geometry" /></mxCell><mxCell id="be_dedup_eng" value="Xử lý Toàn vẹn &amp; Chống trùng lặp (Dedup Engine):&#10;- Kiểm tra Contract Version &amp; Kích thước&#10;- Chuẩn hóa RFC 8785 JSON &amp; SHA-256 Hashing&#10;- Tra cứu messages_dedup (Phát hiện mất ACK sau commit)&#10;- Merge Policy gộp ảnh/trường bổ sung theo owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontFamily=Helvetica;" parent="tier_backend" vertex="1"><mxGeometry x="30" y="175" width="480" height="85" as="geometry" /></mxCell><mxCell id="be_core" value="Lõi Xử lý &amp; Phân tích Đồ thị (rescue_core):&#10;- Data Adapter (to_report_v2: [F, U, N, V])&#10;- Review Queue Manager (Tách ca thiếu tọa độ GPS)&#10;- Graph Construction (Ma trận tương đồng Haversine + F + U)&#10;- Louvain Community Detection (Phân cụm không gian)&#10;- Priority Scoring P(c) = w1*Nc + w2*Vc + w3*Fc + w4*Uc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#5D4037;fontSize=11;fontFamily=Helvetica;" parent="tier_backend" vertex="1"><mxGeometry x="30" y="290" width="480" height="105" as="geometry" /></mxCell><mxCell id="be_db_store" value="Cơ sở Dữ liệu Quan hệ (SQLite / PostgreSQL WAL):&#10;- Bảng: reports, messages_dedup, report_events&#10;- Bảng: teams, operators, sessions, server_meta" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontFamily=Helvetica;" parent="tier_backend" vertex="1"><mxGeometry x="30" y="425" width="480" height="75" as="geometry" /></mxCell><mxCell id="be_upload_fs" value="Lưu trữ Tệp Vật lý (Local File System Storage):&#10;- Thư mục uploads/: Lưu trữ ảnh gốc &amp; ảnh nén hiện trường" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontFamily=Helvetica;" parent="tier_backend" vertex="1"><mxGeometry x="30" y="530" width="480" height="60" as="geometry" /></mxCell><mxCell id="d_auth" value="Xác thực &amp; Bảo mật Điều phối:&#10;- Đăng nhập PBKDF2 Session Token&#10;- Phân quyền Admin / Dispatcher Operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="tier_dashboard" vertex="1"><mxGeometry x="20" y="50" width="400" height="65" as="geometry" /></mxCell><mxCell id="d_gis_map" value="Bản đồ Giám sát Không gian (Leaflet GIS):&#10;- Hiển thị vị trí sự cố, ranh giới cụm &amp; mức ưu tiên&#10;- Chấm tọa độ thủ công cho ca thiếu vị trí" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="tier_dashboard" vertex="1"><mxGeometry x="20" y="145" width="400" height="75" as="geometry" /></mxCell><mxCell id="d_cluster_board" value="Bảng Điều phối Thứ tự Ưu tiên:&#10;- Danh sách cụm theo thứ bậc điểm P(c)&#10;- Drawer Quản lý Hàng xem xét (Review Queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="tier_dashboard" vertex="1"><mxGeometry x="20" y="250" width="400" height="70" as="geometry" /></mxCell><mxCell id="d_case_modal" value="Modal Thao tác Chi tiết Ca Cứu hộ:&#10;- Xem ảnh hiện trường, nhãn AI, số nạn nhân&#10;- Điều động / Gán đội cứu hộ (Teams Assignment)&#10;- Chuyển trạng thái (dispatched -&gt; resolved / cancelled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontFamily=Helvetica;" parent="tier_dashboard" vertex="1"><mxGeometry x="20" y="350" width="400" height="85" as="geometry" /></mxCell><mxCell id="d_admin_tools" value="Công cụ Quản trị &amp; Báo cáo:&#10;- Xuất dữ liệu thống kê CSV / GeoJSON&#10;- Quản lý tài khoản điều phối &amp; Sao lưu CSDL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="tier_dashboard" vertex="1"><mxGeometry x="20" y="465" width="400" height="75" as="geometry" /></mxCell><mxCell id="sa_e1" value="Sync &amp; Upload (HTTP)" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="m_hive_store" target="be_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e2" value="SMS Webhook" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="m_bridge" target="be_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e3" value="Probe &amp; Polling" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="m_ctrl" target="be_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e4" value="Inference Tags" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="m_ai_eng" target="m_ctrl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e5" value="Verify &amp; Dedup" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="be_api" target="be_dedup_eng"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e6" value="Commit Data" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="be_dedup_eng" target="be_db_store"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e7" value="Save Image" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="be_api" target="be_upload_fs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e8" value="Fetch Reports" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="be_db_store" target="be_core"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e9" value="Clusters + ETag" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="be_core" target="d_cluster_board"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e10" value="Poll Changes (5s)" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="d_gis_map" target="be_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sa_e11" value="Assign &amp; Status" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="d_case_modal" target="be_api"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>