<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-03-Gui-Thich-ung-Bang-thong"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="430" y="40" width="100" height="40" as="geometry" /></mxCell><mxCell id="call_deliv" value="Gọi deliverRecord(record, imageFile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="380" y="110" width="200" height="45" as="geometry" /></mxCell><mxCell id="save_hive" value="Ghi vào Outbox Hive Box&#10;(Store-and-forward, pending)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="405" y="185" width="150" height="55" as="geometry" /></mxCell><mxCell id="probe" value="Đo thông lượng mạng&#10;(GET /probe 64 KB trong 6s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="390" y="270" width="180" height="45" as="geometry" /></mxCell><mxCell id="eval_net" value="Phân loại băng thông&#10;&amp; Độ tin cậy AI?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="390" y="345" width="180" height="75" as="geometry" /></mxCell><mxCell id="mode_sms" value="1. MẤT DATA HOÀN TOÀN:&#10;- Gửi tin SMS SOS tóm tắt&#10;- Giữ Outbox chờ mạng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="40" y="460" width="190" height="65" as="geometry" /></mxCell><mxCell id="mode_meta" value="2. MẠNG YẾU (&lt;50 kbps)&#10;hoặc (Mạnh &amp; Conf &gt;= 0.90):&#10;- Gửi metadata JSON&#10;  POST /sync/messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="255" y="460" width="200" height="65" as="geometry" /></mxCell><mxCell id="mode_comp" value="3. MẠNG TRUNG BÌNH (50-1000 kbps):&#10;- Nén JPEG (max 1024px, q=60)&#10;- Gửi multipart POST /api/reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="480" y="460" width="215" height="65" as="geometry" /></mxCell><mxCell id="mode_orig" value="4. MẠNG MẠNH (&gt;=1000 kbps &amp; Conf&lt;0.9):&#10;- Giữ nguyên ảnh gốc&#10;- Gửi multipart POST /api/reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="720" y="460" width="220" height="65" as="geometry" /></mxCell><mxCell id="recv_resp" value="Nhận phản hồi từ Server:&#10;accepted, duplicate, retry_later, rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="565" width="220" height="65" as="geometry" /></mxCell><mxCell id="resp_dec" value="Phản hồi&#10;hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="400" y="660" width="160" height="65" as="geometry" /></mxCell><mxCell id="on_success" value="Thành công (accepted / duplicate):&#10;Đánh dấu synced=true, xóa khỏi Outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="560" y="755" width="220" height="55" as="geometry" /></mxCell><mxCell id="on_retry" value="Lỗi tạm thời (408, 429, 5xx):&#10;Giữ Outbox, Exponential Backoff + Jitter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="180" y="755" width="220" height="55" as="geometry" /></mxCell><mxCell id="poll_status" value="Khởi động Timer Polling 15s&#10;GET /api/reports/status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="845" width="220" height="45" as="geometry" /></mxCell><mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="430" y="925" width="100" height="40" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="start" target="call_deliv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="call_deliv" target="save_hive"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="save_hive" target="probe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="probe" target="eval_net"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Mất data" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="eval_net" target="mode_sms"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="&lt;50k / c&gt;=0.9" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="eval_net" target="mode_meta"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="50-1000k" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="eval_net" target="mode_comp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="&gt;=1000k" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="eval_net" target="mode_orig"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="mode_sms" target="recv_resp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="mode_meta" target="recv_resp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="mode_comp" target="recv_resp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="mode_orig" target="recv_resp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" so