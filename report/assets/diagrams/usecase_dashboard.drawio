<mxfile host="Electron" agent="Antigravity"><diagram id="diag-usecase-dashboard" name="So-do-Use-Case-Chi-tiet-Dashboard"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="750" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys_bound" value="PHÂN HỆ ĐIỀU PHỐI WEB (DISPATCH DASHBOARD)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=32;horizontal=1;fillColor=#DCE8F5;strokeColor=#526B88;strokeWidth=1.5;fontStyle=1;fontSize=16;fontFamily=Helvetica;fontColor=#172B4D;swimlaneFillColor=#F7F9FC;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="850" height="660" as="geometry" /></mxCell><mxCell id="uc_07" value="&lt;div style=&quot;line-height:1;&quot;&gt;UC-07: Đăng nhập &amp; Xác thực phiên&amp;#xa;(phiên làm việc điều phối viên)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="40" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_08" value="&lt;div style=&quot;line-height:1;&quot;&gt;UC-08: Giám sát bản đồ sự cố&amp;#xa;(&amp; thứ tự ưu tiên cứu hộ)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="125" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_10" value="&lt;div style=&quot;line-height:1;&quot;&gt;UC-10: Quản lý danh sách báo cáo&amp;#xa;(xác minh tin báo &amp; lọc dữ liệu)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="210" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_11" value="&lt;div style=&quot;line-height:1;&quot;&gt;UC-11: Tiếp nhận báo cáo tổng đài&amp;#xa;(nhập thủ công tin báo hotline)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="295" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_13" value="&lt;div style=&quot;line-height:1;&quot;&gt;UC-13: Phân công &amp; điều động cứu hộ&amp;#xa;(giao nhiệm vụ cho đội cơ động)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13;fontColor=#172B4D;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="380" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_14" value="&lt;div style=&quot;line-height:1;&quot;&gt;UC-14: Cập nhật tiến độ nhiệm vụ&amp;#xa;(tiến trình cứu nạn tại hiện trường)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="465" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_16" value="&lt;div style=&quot;line-height:1;&quot;&gt;UC-16: Xuất dữ liệu báo cáo cứu hộ&amp;#xa;(kết xuất CSV, GeoJSON, thống kê)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.3;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="sys_bound"><mxGeometry x="90" y="550" width="240" height="50" as="geometry" /></mxCell><mxCell id="uc_09" value="&lt;div style=&quot;line-height:1;&quot;&gt;UC-09: Tự động gom cụm &amp; xếp hạng&amp;#xa;(thuật toán Louvain &amp; P(c))&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDF3FA;strokeColor=#526B88;strokeWidth=1.3;fontFamily=Helvetica;fontSize=13.5;fontColor=#172B4D;" vertex="1" parent="sys_bound"><mxGeometry x="488" y="125" width="244" he