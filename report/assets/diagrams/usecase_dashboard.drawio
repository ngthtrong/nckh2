        </mxCell>
        <mxCell id="text46" parent="1" vertex="1" value="&lt;div&gt;«include»: từ ca cơ sở tới phần dùng chung; «extend»: từ phần mở rộng về ca được mở rộng (UML 2.5.1 §18.1.4).&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=9;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
