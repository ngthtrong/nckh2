        <mxCell id="text45" parent="1" vertex="1" value="&lt;div&gt;Bổ sung tọa độ là mở rộng khi cần xác minh vị trí. Phiên đăng nhập là tiền điều kiện của thao tác được bảo vệ.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=9;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
