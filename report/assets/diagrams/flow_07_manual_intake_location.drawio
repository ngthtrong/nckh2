<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-07-Tiep-nhan-Tong-dai-va-Gan-Vi-tri"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="890" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="390" y="40" width="100" height="40" as="geometry" /></mxCell><mxCell id="recv_call" value="Điều phối viên tiếp nhận:&#10;Cuộc gọi cứu nạn hotline hoặc SMS Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="320" y="110" width="240" height="55" as="geometry" /></mxCell><mxCell id="open_modal" value="Mở modal 'Nhập báo cáo thủ công'&#10;trên giao diện Web Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="195" width="220" height="50" as="geometry" /></mxCell><mxCell id="enter_info" value="Nhập thông tin người gọi:&#10;Tên, SĐT, mô tả, số người kẹt, nhóm yếu thế" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="320" y="275" width="240" height="55" as="geometry" /></mxCell><mxCell id="loc_dec" value="Người gọi có cung cấp&#10;địa chỉ / tọa độ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="360" width="140" height="70" as="geometry" /></mxCell><mxCell id="pick_map" value="XÁC ĐỊNH ĐƯỢC VỊ TRÍ:&#10;Chấm vị trí trên bản đồ Leaflet&#10;hoặc nhập địa chỉ cụ thể" style="rounded=1