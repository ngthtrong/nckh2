<mxfile host="Electron" agent="Antigravity">
  <diagram id="diag-1" name="Luu-do-Tiep-nhan-va-Chong-trung-Backend">
    <mxGraphModel dx="1644" dy="1034" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bd_start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;" value="Nhận Request tới Backend&#xa;(Sync batch / Multipart / SMS)" vertex="1">
          <mxGeometry height="45" width="180" x="330" y="40" as="geometry" />
        </mxCell>
        <mxCell id="bd_header" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" value="Kiểm tra header bắt buộc:&#xa;X-Message-Contract-Version: 1" vertex="1">
          <mxGeometry height="65" width="160" x="340" y="110" as="geometry" />
        </mxCell>
        <mxCell id="bd_bounds" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" value="Kiểm tra giới hạn kích thước:&#xa;- Batch &lt;= 50 messages&#xa;- Tổng request &lt;= 256 KiB&#xa;- Meta &lt;= 64 KiB, Ảnh &lt;= 15 MB" vertex="1">
          <mxGeometry height="70" width="180" x="330" y="200" as="geometry" />
        </mxCell>
        <mxCell id="bd_jcs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" value="Chuẩn tắc hóa JSON theo RFC 8785&#xa;&amp; Tính mã băm SHA-256 payload" vertex="1">
          <mxGeometry height="50" width="190" x="325" y="295" as="geometry" />
        </mxCell>
        <mxCell id="bd_lookup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" value="Tra cứu bảng messages_dedup&#xa;theo message_id &amp; client_id" vertex="1">
          <mxGeometry height="50" width="190" x="325" y="370" as="geometry" />
        </mxCell>
        <mxCell id="bd_dedup_check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" value="Kết quả đối chiếu&#xa;chống trùng lặp?" vertex="1">
          <mxGeometry height="70" width="170" x="335" y="445" as="geometry" />
        </mxCell>
        <mxCell id="bd_dup_ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontFamily=Helvetica;" value="TRÙNG MESSAGE_ID &amp; HASH:&#xa;- Phát hiện mất ACK sau commit&#xa;- Trả duplicate + kết quả cũ&#xa;- Không sửa đổi CSDL (Idempotent)" vertex="1">
          <mxGeometry height="65" width="210" x="40" y="545" as="geometry" />
        </mxCell>
        <mxCell id="bd_err_conflict" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=11;fontFamily=Helvetica;" value="TRÙNG ID KHÁC HASH HOẶC TÁI DÙNG SEQ:&#xa;- Trả lỗi 409 Conflict&#xa;- Mã ID_REUSED_WITH_DIFFERENT_PAYLOAD&#xa;  hoặc SEQUENCE_REUSED" vertex="1">
          <mxGeometry height="65" width="230" x="600" y="545" as="geometry" />
        </mxCell>
        <mxCell id="bd_new_tx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" value="THAO TÁC HỢP LỆ (MỚI):&#xa;Mở SQLite Database Transaction&#xa;Kiểm tra quyền sở hữu report_owner" vertex="1">
          <mxGeometry height="65" width="190" x="325" y="545" as="geometry" />
        </mxCell>
        <mxCell id="bd_merge_check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" value="Báo cáo đã có trong DB?" vertex="1">
          <mxGeometry height="65" width="150" x="345" y="635" as="geometry" />
        </mxCell>
        <mxCell id="bd_merge_apply" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" value="Báo cáo cũ (gộp dữ liệu):&#xa;- Chỉ bổ sung trường còn trống&#xa;- Gắn ảnh nếu trước đó chưa có ảnh&#xa;- Giữ nguyên ảnh đầu tiên và ngày tạo" vertex="1">
          <mxGeometry height="65" width="220" x="150" y="725" as="geometry" />
        </mxCell>
        <mxCell id="bd_create_apply" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#512DA8;fontSize=11;fontFamily=Helvetica;" value="Báo cáo mới hoàn toàn:&#xa;- Tạo bản ghi mới trong bảng reports&#xa;- Trạng thái khởi tạo: processing&#xa;- Lưu file ảnh vật lý (nếu có)" vertex="1">
          <mxGeometry height="65" width="220" x="470" y="725" as="geometry" />
        </mxCell>
        <mxCell id="bd_commit" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontFamily=Helvetica;" value="Commit Transaction:&#xa;- Ghi vết bảng messages_dedup&#xa;- Ghi nhật ký vào report_events&#xa;- Tăng server_meta version (báo cụm stale)" vertex="1">
          <mxGeometry height="70" width="200" x="320" y="820" as="geometry" />
        </mxCell>
