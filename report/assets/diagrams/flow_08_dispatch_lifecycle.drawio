    <mxCell id="e_14" edge="1" parent="1" source="audit_log" target="remove_cluster" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
