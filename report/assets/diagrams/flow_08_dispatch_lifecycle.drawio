    <mxCell id="e_5" value="Không" edge="1" parent="1" source="need_loc" target="pick_team" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
