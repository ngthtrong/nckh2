<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-08-Vong-doi-Dieu-phoi-Cuu-ho"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="390" y="40" width="100" height="40" as="geometry" /></mxCell><mxCell id="view_board" value="Điều phối viên xem danh sách cụm ưu tiên&#10;và bản đồ sự cố Leaflet GIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="320" y="110" width="240" height="55" as="geometry" /></mxCell><mxCell id="select_case" value="Chọn ca cứu hộ cần xử lý:&#10;Xem ảnh hiện trường, nhãn AI, số nạn nhân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="195" width="220" height="55" as="geometry" /></mxCell><mxCell id="gps_check" value="Ca cứu hộ đã có&#10;tọa độ GPS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="280" width="140" height="65" as="geometry" /></mxCell><mxCell id="add_loc" value="BỔ SUNG VỊ TRÍ:&#10;Gọi xác minh &amp; cập nhật tọa độ&#10;PUT /api/reports/{id}/location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="130" y="375" width="220" height="60" as="geometry" /></mxCell><mxCell id="loc_ready" value="Tọa độ hợp lệ,&#10;chuyển sang bước điều động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="530" y="375" width="210" height="50" as="geometry" /></mxCell><mxCell id="pick_team" value="Lựa chọn đội cứu hộ (teams)&#10;phù hợp địa bàn và năng lực" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="465" width="220" height="55" as="geometry" /></mxCell><mxCell id="assign_dispatch" value="Giao đội &amp; Chuyển trạng thái:&#10;PUT /api/reports/{id}/team&#10;status -&gt; dispatched (tăng statusVersion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="320" y="550" width="240" height="65" as="geometry" /></mxCell><mxCell id="field_action" value="Đội cứu hộ tiếp cận hiện trường&#10;và triển khai cứu nạn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="645" width="220" height="50" as="geometry" /></mxCell><mxCell id="res_dec" value="Kết quả cứu hộ&#10;tại thực địa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="725" width="140" height="70" as="geometry" /></mxCell><mxCell id="mark_resolved" value="CỨU HỘ THÀNH CÔNG:&#10;Cập nhật status -&gt; resolved&#10;(Nạn nhân đã được an toàn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="180" y="825" width="220" height="60" as="geometry" /></mxCell><mxCell id="mark_cancelled" value="HỦY CA / TIN GIẢ:&#10;Cập nhật status -&gt; cancelled&#10;(Bắt buộc chọn lý do hủy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="480" y="825" width="220" height="60" as="geometry" /></mxCell><mxCell id="log_audit" value="Ghi audit log vào report_events&#10;(Actor, action, timestamp);&#10;Loại ca khỏi active clusters" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="320" y="915" width="240" height="65" as="geometry" /></mxCell><mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="390" y="1010" width="100" height="40" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="start" target="view_board"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="view_board" target="select_case"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="select_case" target="gps_check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Chưa có" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="gps_check" target="add_loc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Đã có" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="gps_check" target="loc_ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=1.3;fon