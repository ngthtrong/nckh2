<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
      <mxGeometry x="370" y="20" width="60" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="press_sos" value="Người dùng nhấn
nút SOS 1 chạm" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="140" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="get_gps" value="Lấy tọa độ GPS
(Geolocator)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="260" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="gps_ok" value="GPS khả dụng?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="380" width="140" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="set_null" value="Đặt lat/lng = null
(thiếu GPS)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="500" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="create_record" value="Tạo RescueRecord
id=sos-*, status=processing
description=&apos;CỨU HỘ KHẨN CẤP&apos;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="620" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="probe" value="AdaptiveSendPolicy
đo thông lượng mạng
(GET /probe)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="740" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="mode_check" value="Chế độ gửi?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="860" width="140" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="send_http" value="Gửi HTTP trực tiếp
POST /api/messages" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="980" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="send_sms" value="Gửi SMS dự phòng
tới tổng đài" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1100" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="save_outbox" value="Lưu vào Outbox
(Hive store-and-forward)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
      <mxGeometry x="350" y="1220" width="100" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="queue_sync" value="Đăng ký WorkManager
đồng bộ nền khi có mạng" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1340" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="show_status" value="Hiển thị trạng thái
&apos;Đã gửi / Đang chờ&apos;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1460" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
      <mxGeometry x="370" y="1580" width="60" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="e_1" edge="1" parent="1" source="start" target="press_sos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_2" edge="1" parent="1" source="press_sos" target="get_gps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_3" edge="1" parent="1" source="get_gps" target="gps_ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_4" value="Có" edge="1" parent="1" source="gps_ok" target="create_record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_5" value="Không" edge="1" parent="1" source="gps_ok" target="set_null" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_6" edge="1" parent="1" source="set_null" target="create_record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_7" edge="1" parent="1" source="create_record" target="probe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_8" edge="1" parent="1" source="probe" target="mode_check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_9" value="fullData" edge="1" parent="1" source="mode_check" target="send_http" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_10" value="smsFallback" edge="1" parent="1" source="mode_check" target="send_sms" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_11" value="queuedOffline" edge="1" parent="1" source="mode_check" target="save_outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;labelBackgroundColor=none;verticalAlign=bottom;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_12" edge="1" parent="1" source="send_http" target="show_status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_13" edge="1" parent="1" source="send_sms" target="save_outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_14" edge="1" parent="1" source="save_outbox" target="queue_sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_15" edge="1" parent="1" source="queue_sync" target="show_status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_16" edge="1" parent="1" source="show_status" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
