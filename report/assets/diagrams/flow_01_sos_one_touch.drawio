<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-01-SOS-Khancap-1-Cham"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="370" y="40" width="100" height="40" as="geometry" /></mxCell><mxCell id="press_sos" value="Người dùng nhấn nút&#10;'SOS Khẩn cấp' (1 chạm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="110" width="180" height="50" as="geometry" /></mxCell><mxCell id="get_gps" value="Lấy tọa độ GPS tức thời&#10;(Geolocator accuracy high)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="330" y="190" width="180" height="50" as="geometry" /></mxCell><mxCell id="gps_ok" value="Tọa độ GPS&#10;khả dụng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="350" y="270" width="140" height="65" as="geometry" /></mxCell><mxCell id="set_gps" value="Gán tọa độ (lat, lng)&#10;vào bản ghi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="490" y="365" width="160" height="50" as="geometry" /></mxCell><mxCell id="set_null" value="Đặt lat/lng = null&#10;(chờ tổng đài định vị)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="190" y="365" widt