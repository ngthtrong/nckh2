dash" vertex="1"><mxGeometry x="145" y="550" width="130" height="60" as="geometry" /></mxCell><mxCell id="d_ok" value="Thành công: Cập nhật&#10;status -&gt; resolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#4CAF50;" parent="lane_dash" vertex="1"><mxGeometry x="40" y="635" width="140" height="45" as="geometry" /></mxCell><mxCell id="d_cancel" value="Hủy / Tin giả: Cập nhật&#10;status -&gt; cancelled&#10;(bắt buộc chọn reason)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#FFEBEE;strokeColor=#E53935;" parent="lane_dash" vertex="1"><mxGeometry x="210" y="635" width="140" height="50" as="geometry" /></mxCell><mxCell id="d_log" value="Hệ thống ghi report_events&#10;(actor, action, timestamp);&#10;Loại khỏi active clusters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_dash" vertex="1"><mxGeometry x="130" y="715" width="160" height="50" as="geometry" /></mxCell><mxCell id="d_export" value="Xuất báo cáo tổng kết&#10;(CSV / GeoJSON / Stats)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_dash" vertex="1"><mxGeometry x="130" y="790" width="160" height="45" as="geometry" /></mxCell><mxCell id="fl_m1" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="m_start" target="m_choose"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl_m2" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="m_choose" target="m_ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl_m3" value="" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;" parent="1" edge="1" source="m_ai" target