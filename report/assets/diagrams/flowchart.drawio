<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Luu-do-Quy-trinh-He-thong"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lane_mobile" value="ỨNG DỤNG DI ĐỘNG (EDGE MOBILE APP)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#E3F2FD;strokeColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="40" y="40" width="420" height="1060" as="geometry" /></mxCell><mxCell id="lane_server" value="MÁY CHỦ TIẾP NHẬN &amp; DEDUP (FASTAPI / SQLITE)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#512DA8;" parent="1" vertex="1"><mxGeometry x="500" y="40" width="450" height="1060" as="geometry" /></mxCell><mxCell id="lane_core" value="LÕI PHÂN CỤM &amp; ƯU TIÊN (RESCUE_CORE)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#EFEBE9;strokeColor=#5D4037;" parent="1" vertex="1"><mxGeometry x="990" y="40" width="420" height="1060" as="geometry" /></mxCell><mxCell id="lane_dash" value="ĐIỀU PHỐI VIÊN &amp; ĐỘI CỨU HỘ (DASHBOARD)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFF8E1;strokeColor=#F57C00;" parent="1" vertex="1"><mxGeometry x="1450" y="40" width="420" height="1060" as="geometry" /></mxCell><mxCell id="m_start" value="Bắt đầu&#10;(Mở App)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;" parent="lane_mobile" vertex="1"><mxGeometry x="160" y="50" width="100" height="40" as="geometry" /></mxCell><mxCell id="m_choose" value="Chọn: Gửi SOS 1 chạm&#10;hoặc Báo cáo chi tiết" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_mobile" vertex="1"><mxGeometry x="120" y="110" width="180" height="45" as="geometry" /></mxCell><mxCell id="m_ai" value="Chụp ảnh -&gt; On-device AI&#10;(MobileNetV3 ONNX/ExecuTorch)&#10;-&gt; Mức ngập &amp; Confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#D81B60;" parent="lane_mobile" vertex="1"><mxGeometry x="120" y="180" width="180" height="55" as="geometry" /></mxCell><mxCell id="m_form" value="Nhập tọa độ (GPS/tay),&#10;số người kẹt, bị thương,&#10;nhóm yếu thế -&gt; Urgency score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_mobile" vertex="1"><mxGeometry x="120" y="260" width="180" height="50" as="geometry" /></mxCell><mxCell id="m_hive" value="Ghi Outbox (Hive)&#10;Store-and-Forward&#10;(RFC 8785 SHA-256 hash)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;" parent="lane_mobile" vertex="1"><mxGeometry x="135" y="335" width="150" height="55" as="geometry" /></mxCell><mxCell id="m_probe" value="Đo throughput&#10;(GET /probe 64 KB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_mobile" vertex="1"><mxGeometry x="135" y="415" width="150" height="40" as="geometry" /></mxCell><mxCell id="m_net_dec" value="Đánh giá mạng&#10;&amp; Confidence AI" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="lane_mobile" vertex="1"><mxGeometry x="140" y="480" width="140" height="65" as="geometry" /></mxCell><mxCell id="m_sms" value="Gửi SMS dự phòng&#10;tới Gateway&#10;(kèm pending Outbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#FFEBEE;strokeColor=#E53935;" parent="lane_mobile" vertex="1"><mxGeometry x="20" y="575" width="130" height="50" as="geometry" /></mxCell><mxCell id="m_meta_only" value="Gửi chỉ Metadata JSON&#10;(POST /sync/messages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_mobile" vertex="1"><mxGeometry x="160" y="575" width="140" height="50" as="geometry" /></mxCell><mxCell id="m_img_post" value="Nén/giữ ảnh + Meta&#10;(POST /api/reports multipart)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_mobile" vertex="1"><mxGeometry x="280" y="650" width="130" height="50" as="geometry" /></mxCell><mxCell id="m_wait_ack" value="Nhận phản hồi ACK&#10;&amp; cập nhật synced=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_mobile" vertex="1"><mxGeometry x="135" y="730" width="150" height="45" as="geometry" /></mxCell><mxCell id="m_poll" value="Polling 15s trạng thái&#10;(GET /api/reports/status)&#10;nhận tiến trình cứu hộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_mobile" vertex="1"><mxGeometry x="135" y="805" width="150" height="50" as="geometry" /></mxCell><mxCell id="m_end" value="Kết thúc&#10;(Được cứu / Hoàn tất)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#607D8B;strokeColor=#37474F;fontColor=#FFFFFF;fontStyle=1;" parent="lane_mobile" vertex="1"><mxGeometry x="160" y="890" width="100" height="40" as="geometry" /></mxCell><mxCell id="s_recv" value="Tiếp nhận Request&#10;(Sync batch / Reports / SMS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_server" vertex="1"><mxGeometry x="140" y="180" width="170" height="45" as="geometry" /></mxCell><mxCell id="s_val" value="Kiểm tra Header version,&#10;bounds size &amp; tính canonical&#10;SHA-256 payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_server" vertex="1"><mxGeometry x="140" y="250" width="170" height="55" as="geometry" /></mxCell><mxCell id="s_dedup_dec" value="Tra cứu messages_dedup&#10;(message_id, hash, seq)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="lane_server" vertex="1"><mxGeometry x="145" y="330" width="160" height="70" as="geometry" /></mxCell><mxCell id="s_dup" value="Trùng id &amp; hash:&#10;Trả ACK duplicate cũ&#10;(Idempotent, không ghi đè)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#4CAF50;" parent="lane_server" vertex="1"><mxGeometry x="20" y="430" width="135" height="55" as="geometry" /></mxCell><mxCell id="s_rej" value="Trùng id khác hash /&#10;tái sử dụng sequence:&#10;Từ chối 409 Conflict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#FFEBEE;strokeColor=#E53935;" parent="lane_server" vertex="1"><mxGeometry x="295" y="430" width="135" height="55" as="geometry" /></mxCell><mxCell id="s_tx" value="Thao tác hợp lệ:&#10;Mở DB Transaction,&#10;Kiểm tra report_owner&#10;(Merge ảnh/trường trống)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_server" vertex="1"><mxGeometry x="140" y="515" width="170" height="65" as="geometry" /></mxCell><mxCell id="s_db" value="Lưu SQLite: reports,&#10;messages_dedup, files ảnh;&#10;Ghi log report_events" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;" parent="lane_server" vertex="1"><mxGeometry x="145" y="610" width="160" height="60" as="geometry" /></mxCell><mxCell id="s_meta" value="Tăng version dữ liệu&#10;trong server_meta&#10;(đánh dấu cụm stale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_server" vertex="1"><mxGeometry x="145" y="700" width="160" height="45" as="geometry" /></mxCell><mxCell id="s_ack" value="Trả HTTP Response&#10;(accepted / 201 Created)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_server" vertex="1"><mxGeometry x="145" y="770" width="160" height="40" as="geometry" /></mxCell><mxCell id="c_trig" value="Kích hoạt phân cụm&#10;(Polling Dashboard /&#10;background warmup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="130" y="200" width="160" height="45" as="geometry" /></mxCell><mxCell id="c_ver_dec" value="Kiểm tra ETag /&#10;cluster_version đổi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="140" y="275" width="140" height="60" as="geometry" /></mxCell><mxCell id="c_304" value="Không đổi: Trả 304&#10;Not Modified (ETag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="20" y="360" width="120" height="45" as="geometry" /></mxCell><mxCell id="c_fetch" value="Có đổi: Lấy danh sách&#10;báo cáo active_only&#10;(bỏ resolved/cancelled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="140" y="360" width="160" height="50" as="geometry" /></mxCell><mxCell id="c_adapt" value="Adapter to_report_v2:&#10;Trích xuất [F, U, N, V],&#10;Tách ca thiếu tọa độ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="140" y="435" width="160" height="50" as="geometry" /></mxCell><mxCell id="c_rev" value="Đưa ca thiếu GPS vào&#10;Hàng xem xét (Review Queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;fillColor=#FFF3E0;strokeColor=#FB8C00;" parent="lane_core" vertex="1"><mxGeometry x="20" y="515" width="140" height="50" as="geometry" /></mxCell><mxCell id="c_graph" value="Xây dựng ma trận tương đồng&#10;C_ij (khoảng cách Haversine,&#10;mức ngập, độ khẩn cấp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="180" y="515" width="170" height="55" as="geometry" /></mxCell><mxCell id="c_louvain" value="Phân cụm cộng đồng Louvain&#10;&amp; Xác định clusterKey&#10;(ID nhỏ nhất trong cụm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="180" y="595" width="170" height="55" as="geometry" /></mxCell><mxCell id="c_score" value="Tính điểm ưu tiên P(c)&#10;cho từng cụm -&gt; Xếp hạng cụm&#10;&amp; Ghi cache Snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="140" y="675" width="160" height="50" as="geometry" /></mxCell><mxCell id="c_resp" value="Trả JSON cụm + ETag&#10;cho Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="lane_core" vertex="1"><mxGeometry x="140" y="750" width="160" height="40" as="geometry" /></mxCell><mxCell id="d_login" value="Đăng nhập Dashboard&#10;(Phiên làm việc Operator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#