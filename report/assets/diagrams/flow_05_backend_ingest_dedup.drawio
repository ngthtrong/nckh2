<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
      <mxGeometry x="370" y="20" width="60" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="recv" value="Server nhận request
POST /api/messages
hoặc /api/reports" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="140" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="check_header" value="Kiểm tra header
X-Message-Contract-Version
&amp; kích thước payload" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="260" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="valid_header" value="Header
hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="380" width="140" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="reject_400" value="Trả lỗi
400 Bad Request" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="500" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="normalize" value="Chuẩn tắc hóa JSON
(RFC 8785)
Tính SHA-256 hash" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="620" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="lookup_dedup" value="Tra cứu bảng
messages_dedup
theo message_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
      <mxGeometry x="350" y="740" width="100" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="dedup_result" value="Kết quả
trùng?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="860" width="140" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="dup_same" value="Trùng ID &amp; trùng Hash
→ Trả kết quả cũ
(Idempotent OK)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="980" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="conflict" value="Trùng ID khác Hash
→ Trả lỗi
409 Conflict" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1100" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="open_tx" value="Mở Database
Transaction (SQLite)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;strokeColor=#ffffff;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;html=1;" vertex="1" parent="1">
      <mxGeometry x="361" y="1220" width="78" height="78" as="geometry"/>
    </mxCell>
    <mxCell id="check_owner" value="Kiểm tra quyền
report_owner
(chỉ chủ bổ sung)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1340" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="write_db" value="Ghi dữ liệu:
reports, messages_dedup
report_events" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
      <mxGeometry x="350" y="1460" width="100" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="bump_ver" value="Tăng version
trong server_meta" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1580" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="commit" value="Commit Transaction
Trả HTTP 200/201" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
      <mxGeometry x="330" y="1700" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
      <mxGeometry x="370" y="1820" width="60" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="e_1" edge="1" parent="1" source="start" target="recv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_2" edge="1" parent="1" source="recv" target="check_header" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourcePerimeterSpacing=10;targetPerimeterSpacing=10;jumpStyle=arc;">
