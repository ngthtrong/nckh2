<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="So-do-Trien-khai-Ha-tang-Docker"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="d_host" value="MÁY CHỦ TRIỂN KHAI DỊCH VỤ (DOCKER COMPOSE HOST)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#424242;" parent="1" vertex="1"><mxGeometry x="380" y="40" width="820" height="780" as="geometry" /></mxCell><mxCell id="c_backend" value="Container: rescue-backend&#10;- FastAPI + Uvicorn Server&#10;- Lõi rescue_core phân cụm Louvain&#10;- Port 8000:8000 (Internal API)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fontFamily=Helvetica;align=center;fillColor=#EDE7F6;strokeColor=#512DA8;" parent="d_host" vertex="1"><mxGeometry x="40" y="60" width="350" height="90" as="geometry" /></mxCell><mxCell id="c_dashboard" value="Container: rescue-dashboard&#10;- Nginx Web Server&#10;- React + Leaflet SPA static files&#10;- Port 8080:80 (Dispatcher Dashboard)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fontFamily=Helvetica;align=center;fillColor=#FFF8E1;strokeColor=#F57C00;" parent="d_host" vertex="1"><mxGeometry x="420" y="60" width="350" height="90" as="geometry" /></mxCell><mxCell id="c_frontend_demo" value="Container: rescue-demo-frontend&#10;- Flutter Web compiled bundle&#10;- Môi trường kiểm thử web app&#10;- Port 8081:80 (Demo Web App)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fontFamily=Helvetica;align=center;fillColor=#E3F2FD;strokeColor=#1976D2;" parent="d_host" vertex="1"><mxGeometry x="40" y="190" width="350" height="85" as="geometry" /></mxCell><mxCell id="v_db" value="Docker Named Volume: sqlite_data&#10;- /app/data/rescue.db (SQLite WAL Mode)&#10;- Dữ liệu reports, deduplication, teams, events" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontFamily=Helvetica;" parent="d_host" vertex="1"><mxGeometry x="40" y="320" width="350" height="80" as="geometry" /></mxCell><mxCell id="v_uploads" value="Docker Named Volume: uploads_data&#10;- /app/uploads/ (Ảnh chụp hiện trường)&#10;- Đọc/ghi ảnh multipart từ thiết bị" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontFamily=Helvetica;" parent="d_host" vertex="1"><mxGeometry x="420" y="320" width="350" height="80" as="geometry" /></mxCell><mxCell id="dev_phone" value="Thiết bị Di động Android (Client):&#10;- Cài đặt file APK (Flutter App)&#10;- Camera, GPS, Local Hive DB&#10;- ONNX Runtime &amp; ExecuTorch Native" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fontFamily=Helvetica;align=center;fillColor=#E8F5E9;strokeColor=#2E7D32;" parent="1" vertex="1"><mxGeometry x="40" y="160" width="280" height="110" as="geometry" /></mxCell><mxCell id="dev_dispatcher" value="Máy tính Điều phối viên (Dispatcher PC):&#10;- Trình duyệt Web (Chrome, Edge, Firefox)&#10;- Truy cập Dashboard qua Port 8080" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fontFamily=Helvetica;align=center;fillColor=#FFF3E0;strokeColor=#FB8C00;" parent="1" vertex="1"><mxGeometry x="40" y="420" width="280" height="100" as="geometry" /></mxCell><mxCell id="dev_sms_gw" value="SMS Gateway / GSM Modem GSM:&#10;- Tiếp nhận tin nhắn SOS từ vùng mất mạng&#10;- Chuyển tiếp Webhook tới /api/sms/inbound" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fontFamily=Helvetica;align=center;fillColor=#FFEBEE;strokeColor=#E53935;" parent="1" vertex="1"><mxGeometry x="40" y="650" width="280" height="100" as="geometry" /></mxCell><mxCell id="dep_e1" value="Wi-Fi / 4G (HTTP :8000)" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="dev_phone" target="c_backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep_e2" value="Web Browser (HTTP :8080)" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="dev_dispatcher" target="c_dashboard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep_e3" value="API Proxy / Data" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="c_dashboard" target="c_backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep_e4" value="SMS Webhook (:8000)" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="dev_sms_gw" target="c_backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep_e5" value="Mounts" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="c_backend" target="v_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dep_e6" value="Mounts" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="c_backend" target="v_uploads"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>