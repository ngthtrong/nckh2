<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Kien-truc-Phan-lop-Mobile-Flutter"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="l_pres" value="1. PRESENTATION LAYER (GIAO DIỆN &amp;amp; QUẢN LÝ TRẠNG THÁI)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#E3F2FD;strokeColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="40" y="40" width="1120" height="180" as="geometry" /></mxCell><mxCell id="l_dom" value="2. DOMAIN LAYER (NGHIỆP VỤ &amp;amp; QUY TẮC CỐT LÕI - THUẦN DART)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#512DA8;" parent="1" vertex="1"><mxGeometry x="40" y="250" width="1120" height="180" as="geometry" /></mxCell><mxCell id="l_data" value="3. DATA LAYER (DỮ LIỆU &amp;amp; HIỆN THỰC REPOSITORY)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#2E7D32;" parent="1" vertex="1"><mxGeometry x="40" y="460" width="1120" height="200" as="geometry" /></mxCell><mxCell id="l_plat" value="4. PLATFORM CHANNELS &amp;amp; NATIVE HARDWARE BRIDGES" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#455A64;" parent="1" vertex="1"><mxGeometry x="40" y="690" width="1120" height="160" as="geometry" /></mxCell><mxCell id="p_views" value="UI Views &amp;amp; Screens:&#10;- HomeScreen (Tổng quan &amp;amp; Nút SOS 1 chạm)&#10;- ComposeScreen (Soạn báo cáo cứu trợ kèm ảnh)&#10;- HistoryScreen / SubmittedScreen (Tra cứu tiến trình)&#10;- SettingsScreen (Cấu hình máy chủ &amp;amp; Tải model AI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_pres" vertex="1"><mxGeometry x="40" y="45" width="480" height="110" as="geometry" /></mxCell><mxCell id="p_ctrl" value="Controllers &amp;amp; State Management:&#10;- AppController (Quản lý trạng thái trung tâm qua ChangeNotifier)&#10;- Điều phối luồng gửi SOS &amp;amp; Soạn bài cứu nạn&#10;- Đánh giá thông lượng mạng (Probe) &amp;amp; Chọn chế độ gửi thích ứng&#10;- Thăm dò định kỳ trạng thái điều phối (15s Timer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_pres" vertex="1"><mxGeometry x="560" y="45" width="520" height="110" as="geometry" /></mxCell><mxCell id="d_repo_intf" value="Repository Interfaces (Abstractions):&#10;- RescueRepository (Lưu &amp;amp; gửi báo cáo)&#10;- InferenceRepository (Suy luận AI)&#10;- NetworkRepository (Đo kiểm mạng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_dom" vertex="1"><mxGeometry x="40" y="45" width="340" height="115" as="geometry" /></mxCell><mxCell id="d_uc" value="Use Cases &amp;amp; Business Policies:&#10;- SendSosUseCase (Gửi SOS khẩn)&#10;- SubmitRescuePostUseCase (Gửi bài kèm ảnh)&#10;- DeliverRecordUseCase (Thực thi gửi thích ứng)&#10;- AdaptiveSendPolicy &amp;amp; UrgencyLogisticModel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_dom" vertex="1"><mxGeometry x="410" y="45" width="350" height="115" as="geometry" /></mxCell><mxCell id="d_ent" value="Entities &amp;amp; Value Objects:&#10;- RescueRecord (id, status, gps, urgency)&#10;- AiTag (label, confidence)&#10;- SendMode (fullImage, compressedImage,&#10;  textOnly, smsFallback, queuedOffline)&#10;- SyncMessage (payload_hash, sequence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_dom" vertex="1"><mxGeometry x="790" y="45" width="300" height="115" as="geometry" /></mxCell><mxCell id="dt_repo" value="Repository Implementations:&#10;- RescueRepositoryImpl&#10;- InferenceRepositoryImpl (Conditional export)&#10;- NetworkRepositoryImpl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_data" vertex="1"><mxGeometry x="40" y="45" width="340" height="130" as="geometry" /></mxCell><mxCell id="dt_local" value="Local DataSources:&#10;- OutboxLocalDataSource (Hive store-and-forward)&#10;- RecordLocalDataSource (Lưu trữ bản ghi offline)&#10;- RFC 8785 Canonical JCS &amp;amp; SHA-256 Hasher" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=10;fontFamily=Helvetica;spacingTop=16;align=center;" parent="l_data" vertex="1"><mxGeometry x="410" y="45" width="340" height="130" as="geometry" /></mxCell><mxCell id="dt_remote" value="Remote &amp;amp; Native DataSources:&#10;- SenderRemoteDataSource (FastAPI REST &amp;amp; Multipart)&#10;- SyncRemoteDataSource (/sync/messages Batch)&#10;- NetworkRemoteDataSource (GET /probe 64KB)&#10;- InferenceLocalDataSource (ONNX / ExecuTorch PTE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_data" vertex="1"><mxGeometry x="780" y="45" width="310" height="130" as="geometry" /></mxCell><mxCell id="pl_gps" value="Geolocator (GPS Location Service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_plat" vertex="1"><mxGeometry x="40" y="50" width="240" height="65" as="geometry" /></mxCell><mxCell id="pl_cam" value="Camera &amp;amp; Image Picker (Ảnh hiện trường)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_plat" vertex="1"><mxGeometry x="310" y="50" width="240" height="65" as="geometry" /></mxCell><mxCell id="pl_sms" value="Android Telephony (MethodChannel rescue/sms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=11;fontFamily=Helvetica;" parent="l_plat" vertex="1"><mxGeometry x="580" y="50" width="240" height="65" as="geometry" /></mxCell><mxCell id="pl_wm" value="Workmanager (Tiến trình nền 15 phút)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_plat" vertex="1"><mxGeometry x="850" y="50" width="240" height="65" as="geometry" /></mxCell><mxCell id="ma_e1" value="Calls" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="p_ctrl" target="d_uc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e6" value="Uses" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="d_uc" target="d_repo_intf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e10" value="Uses" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="d_uc" target="d_ent"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e2" value="Implements" style="endArrow=classic;html=1;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontStyle=1;" parent="1" edge="1" source="dt_repo" target="d_repo_intf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e3" value="Uses" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="dt_repo" target="dt_local"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e4" value="Uses" style="endArrow=classic;html=1;strokeColor=#37474F;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="dt_repo" target="dt_remote"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e5" value="Hardware Channel" style="endArrow=classic;html=1;strokeColor=#E53935;strokeWidth=1.3;fontSize=10;fontFamily=Helvetica;" parent="1" edge="1" source="dt_remote" target="pl_sms"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e7" value="Background Sync" style="endArrow=classic;html=1;strokeColor=#455A64;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;dashed=1;" parent="1" edge="1" source="dt_local" target="pl_wm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e8" value="Platform Service" style="endArrow=classic;html=1;strokeColor=#455A64;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;dashed=1;" parent="1" edge="1" source="dt_repo" target="pl_gps"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ma_e9" value="Device Picker" style="endArrow=classic;html=1;strokeColor=#455A64;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;dashed=1;" parent="1" edge="1" source="dt_repo" target="pl_cam"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>