<mxfile host="app.diagrams.net" agent="Antigravity" version="24.0.0"><diagram id="diag-1" name="Kien-truc-Phan-lop-Mobile-Flutter"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="l_pres" value="1. PRESENTATION LAYER (GIAO DIỆN &amp; TRẠNG THÁI)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#E3F2FD;strokeColor=#1976D2;" parent="1" vertex="1"><mxGeometry x="40" y="40" width="1120" height="180" as="geometry" /></mxCell><mxCell id="l_dom" value="2. DOMAIN LAYER (NGHIỆP VỤ &amp; QUY TẮC CỐT LÕI)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#EDE7F6;strokeColor=#512DA8;" parent="1" vertex="1"><mxGeometry x="40" y="250" width="1120" height="180" as="geometry" /></mxCell><mxCell id="l_data" value="3. DATA LAYER (DỮ LIỆU &amp; REPOSITORY IMPLEMENTATION)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#E8F5E9;strokeColor=#2E7D32;" parent="1" vertex="1"><mxGeometry x="40" y="460" width="1120" height="200" as="geometry" /></mxCell><mxCell id="l_plat" value="4. PLATFORM CHANNELS &amp; NATIVE HARDWARE BRIDGES" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=28;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#455A64;" parent="1" vertex="1"><mxGeometry x="40" y="690" width="1120" height="150" as="geometry" /></mxCell><mxCell id="p_views" value="UI Views / Screens:&#10;- SosScreen (Gửi SOS 1 chạm)&#10;- CreateReportScreen (Biểu mẫu kèm ảnh)&#10;- RescueTimelineScreen (Tra cứu tiến trình)&#10;- MapOverviewScreen (Bản đồ offline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_pres" vertex="1"><mxGeometry x="40" y="50" width="480" height="95" as="geometry" /></mxCell><mxCell id="p_ctrl" value="Controllers / State Management:&#10;- SosController &amp; ReportFormController&#10;- ConnectivityController &amp; ProbeEvaluator&#10;- StatusPollingController (15s Timer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_pres" vertex="1"><mxGeometry x="580" y="50" width="480" height="95" as="geometry" /></mxCell><mxCell id="d_ent" value="Entities &amp; Models:&#10;- RescueRecord (id, status, gps, urgency)&#10;- AiTag (label, confidence)&#10;- SendMode (smsFallback, metadataOnly, compressedImage, originalImage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_dom" vertex="1"><mxGeometry x="40" y="50" width="480" height="95" as="geometry" /></mxCell><mxCell id="d_uc" value="Use Cases &amp; Business Policies:&#10;- AnalyzeImageUseCase (Khởi chạy mô hình AI)&#10;- DeliverRecordUseCase (Chính sách thích ứng)&#10;- ProbeNetworkUseCase &amp; PollStatusUseCase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_dom" vertex="1"><mxGeometry x="580" y="50" width="480" height="95" as="geometry" /></mxCell><mxCell id="dt_repo" value="Repository Implementations:&#10;- RescueRepositoryImpl&#10;- InferenceRepositoryImpl (Conditional export)&#10;- NetworkProbeRepositoryImpl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E88E5;fontSize=11;fontFamily=Helvetica;" parent="l_data" vertex="1"><mxGeometry x="40" y="45" width="340" height="120" as="geometry" /></mxCell><mxCell id="dt_local" value="Local DataSources:&#10;- HiveBoxLocalDataSource (Outbox store-and-forward)&#10;- RFC 8785 Canonical JSON Encoder &amp; SHA-256 Hasher" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECEFF1