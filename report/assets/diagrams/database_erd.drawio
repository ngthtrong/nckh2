        </mxCell>
        <mxCell id="text122" parent="1" vertex="1" value="&lt;div&gt;Status version only increases&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=12;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
          <mxGeometry x="720.0" y="503.52" width="177.40999999999997" height="14.960000000000036" as="geometry" />
        </mxCell>
        <mxCell id="text123" parent="1" vertex="1" value="&lt;div&gt;At most one team and one photo&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=12;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
          <mxGeometry x="720.0" y="519.52" width="199.64" height="14.960000000000036" as="geometry" />
        </mxCell>
        <mxCell id="text124" parent="1" vertex="1" value="&lt;div&gt;Design model: Location, Assessment and Photo are embedded value objects, not separate SQLite tables.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=12;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
          <mxGeometry x="10.999999999999998" y="554.52" width="631.6399999999999" height="14.960000000000036" as="geometry" />
        </mxCell>
        <mxCell id="text125" parent="1" vertex="1" value="&lt;div&gt;Client identity may be absent. Operator–event association is conceptual; current storage keeps actor labels.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=12;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
          <mxGeometry x="10.999999999999998" y="572.52" width="650.8999999999999" height="14.960000000000036" as="geometry" />
