          <mxGeometry x="720.0" y="471.52" width="140.96000000000004" height="14.95999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text121" parent="1" vertex="1" value="&lt;div&gt;Final: resolved / cancelled&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=12;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
