        <mxCell id="text48" parent="1" vertex="1" value="&lt;div&gt;Hình mô tả JSON sync; multipart và SMS có luồng riêng.&lt;br&gt;Nét đứt: gom ACK. Lỗi một message không hủy các message khác.&lt;br&gt;Cùng ID và hash chỉ cho biết thao tác đã được xử lý, không xác định lý do retry.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=9;fontStyle=0;fontColor=#203B50;spacing=0;overflow=visible;">
