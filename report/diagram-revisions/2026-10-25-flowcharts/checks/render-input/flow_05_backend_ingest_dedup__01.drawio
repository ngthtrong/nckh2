        <mxCell id="scope_note" value="POST /sync/messages: header hợp đồng phiên bản 1; tối đa 50 message, tổng 256 KiB. Quá dung lượng trả HTTP 413. ID/hash hoặc sequence xung đột trả rejected trong kết quả từng message; HTTP batch vẫn có thể là 200." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fontFamily=Arial;fontSize=15;fontColor=#44546A;fillColor=#F5F7FA;strokeColor=#D5DFEB;" vertex="1" parent="1">
