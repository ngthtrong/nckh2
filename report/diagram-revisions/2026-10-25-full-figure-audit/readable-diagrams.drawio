        </mxCell>
        <mxCell id="text22" parent="1" vertex="1" value="&lt;div&gt;≥1000 kbit/s: ảnh gốc&lt;br&gt;Confidence ≥0,90: có thể chỉ text&lt;br&gt;50–&amp;lt;1000: ảnh nén&lt;br&gt;&amp;lt;50 nhưng có data: chỉ text&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=9.5;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
