        <mxCell id="text20" parent="1" vertex="1" value="&lt;div&gt;Nếu có ảnh: đo /probe&lt;br&gt;64 KiB; ngân sách 6 s&lt;br&gt;Đánh giá lại khi đồng bộ muộn&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=9.5;fontStyle=0;fontColor=#111111;spacing=0;overflow=visible;">
