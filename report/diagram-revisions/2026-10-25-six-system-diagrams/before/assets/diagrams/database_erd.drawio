        </mxCell>
        <mxCell id="text57" parent="1" vertex="1" value="&lt;div&gt;Chỉ liệt kê các cột chính. messages_dedup không có khóa ngoại đến reports.&lt;br&gt;Ký hiệu: | một; o| không hoặc một; o&amp;lt; không hoặc nhiều.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=9;fontStyle=0;fontColor=#203B50;spacing=0;overflow=visible;">
