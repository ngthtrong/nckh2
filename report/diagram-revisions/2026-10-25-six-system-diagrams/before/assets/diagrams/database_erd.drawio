        <mxCell id="text56" parent="1" vertex="1" value="&lt;div&gt;PK: khóa chính; UQ: duy nhất.&lt;br&gt;Nét đứt: liên hệ do mã quản lý.&lt;br&gt;DDL chưa khai báo khóa ngoại.&lt;br&gt;actor lưu tên, không phải FK.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=9;fontStyle=0;fontColor=#203B50;spacing=0;overflow=visible;">
