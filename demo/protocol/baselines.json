    {
      "id": "product_louvain",
      "role": "proposed",
      "hypothesis": "Product gating preserves incident integrity while suppressing geographically distant edges that match only time or context.",
      "literature_ids": ["blondel2008"],
      "implementation": {
        "entry_points": [
          "demo.pipeline.weighting.build_weight_matrix_vec",
          "demo.pipeline.clustering.run_louvain"
        ],
        "dependencies": ["networkx", "numpy", "python-louvain"],
        "status": "available"
      },
      "inputs": ["geo", "time", "context"],
      "preset_k": false,
      "search_space": {
        "sigma_geo_m": [500, 700, 900, 1200],
        "threshold_quantile": [0.85, 0.9, 0.95, 0.98],
        "tau_temp_min": [30, 60],
        "knn": [8, 16],
        "resolution": [0.8, 1.2]
      },
      "configuration_count": 128
    },
    {
