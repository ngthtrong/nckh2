* text=auto

# Canonical source and documentation formats.
*.py text eol=lf
*.json text eol=lf
*.log text eol=lf
revision/clean-room-full.log -whitespace
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.mmd text eol=lf

# Additional repository text formats covered by the submission package.
*.bst text eol=lf
*.cjs text eol=lf
*.cls text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.lock text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Byte-exact binary artifacts.
*.eps -text
*.gz -text
*.jpeg -text
*.jpg -text
*.pdf -text
*.png -text
